assert_fails 'closing the current workspace removes its session' "$TMUX" has-session -t '=close-current'
CLOSE_FALLBACK=$("$TMUX" display-message -p -c "$CLOSE_CLIENT" '#{session_name}')
[[ -n $CLOSE_FALLBACK && $CLOSE_FALLBACK != close-current ]] || fail 'closing the current workspace switches its client'
pass 'closing the current workspace switches its client'
"$TMUX" detach-client -t "$CLOSE_CLIENT"
wait "$CLOSE_CLIENT_PID" 2>/dev/null || true

