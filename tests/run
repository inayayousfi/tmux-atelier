"$TMUX" set-option -g @atelier_restore always
"$CLI" restore-arm
assert_fails 'runtime restore failures are reported' "$CLI" restore-start
assert_fails 'runtime failures roll back earlier restored sessions' "$TMUX" has-session -t '=restore-remote'
assert_equal 1 "$("$TMUX" show-options -gqv @atelier_restore_pending)" 'runtime failures keep the snapshot pending'
assert_equal 0 "$("$TMUX" show-options -gqv @atelier_restore_handled)" 'runtime failures allow a later retry'
"$TMUX" set-option -g @atelier_restore prompt
assert_fails 'a missing prompt client is reported' "$CLI" restore-start missing-client
assert_equal 1 "$("$TMUX" show-options -gqv @atelier_restore_pending)" 'prompt launch failures keep the snapshot pending'
assert_equal 0 "$("$TMUX" show-options -gqv @atelier_restore_handled)" 'prompt launch failures allow another attachment to retry'

printf '1..%d\n' "$TESTS"
