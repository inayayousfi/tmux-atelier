    wait "$RESTORE_SNAPSHOT_PID"
done
assert_file "$RESTORE_STATE/restore.snapshot" 'open workspace topology is persisted'
[[ ! -d $RESTORE_STATE/.snapshot.lock ]] || fail 'concurrent snapshots release their serialization lock'
pass 'concurrent snapshots are serialized and release their lock'
assert_equal 600 "$(stat -c '%a' "$RESTORE_STATE/restore.snapshot")" 'restore snapshot permissions are private'
SOURCE_WINDOWS=$("$TMUX" list-windows -t '=restore-me:' -F '#{window_name}')
SOURCE_MAIN_GEOMETRY=$("$TMUX" list-panes -t "$RESTORE_FIRST_WINDOW" -F '#{pane_left},#{pane_top},#{pane_width},#{pane_height}')
SOURCE_MAIN_PATHS=$("$TMUX" list-panes -t "$RESTORE_FIRST_WINDOW" -F '#{pane_current_path}')
SOURCE_ACTIVE_GEOMETRY=$("$TMUX" display-message -p -t "${RESTORE_SOURCE_PANES[1]}" '#{pane_left},#{pane_top},#{pane_width},#{pane_height}')
cp "$RESTORE_STATE/restore.snapshot" "$TEST_ROOT/valid-restore.snapshot"
mapfile -d '' -t RESTORE_SNAPSHOT_FIELDS < "$TEST_ROOT/valid-restore.snapshot"
RESTORE_EXPECTED_ACTIVE=${RESTORE_SNAPSHOT_FIELDS[3]}
"$TMUX" kill-server

export TMUX_ATELIER_TEST_SOCKET="atelier-restore-always-$$"
"$TMUX" new-session -d -s bootstrap 'sleep 120'
"$TMUX" set-option -g @atelier_restore always
sleep 20 | env -u TMUX "$TMUX" -C attach-session -t '=bootstrap' > "$TEST_ROOT/restore-client.log" 2>&1 &
RESTORE_CLIENT_PID=$!
RESTORE_CLIENT=
for _ in {1..10}; do
    RESTORE_CLIENT=$("$TMUX" list-clients -F '#{client_name}' 2>/dev/null || true)
    [[ -n $RESTORE_CLIENT ]] && break
    sleep 0.1
done
[[ -n $RESTORE_CLIENT ]] || fail "control client starts for restoration: $(< "$TEST_ROOT/restore-client.log")"
"$ROOT/tmux-atelier.tmux"
for _ in {1..20}; do
    if "$TMUX" has-session -t '=restore-me' 2>/dev/null &&
        ! "$TMUX" has-session -t '=bootstrap' 2>/dev/null; then
        break
    fi
    sleep 0.1
done
"$TMUX" has-session -t '=restore-me' || fail 'always policy restores the saved workspace'
pass 'plugin restores saved workspaces when its first client was already attached'
assert_fails 'successful restoration removes the current-directory bootstrap session' "$TMUX" has-session -t '=bootstrap'
assert_equal "$RESTORE_EXPECTED_ACTIVE" "$("$TMUX" display-message -p -c "$RESTORE_CLIENT" '#{session_name}')" 'restoration switches the client to the previously active workspace'
"$TMUX" has-session -t '=restore-remote' || fail 'always policy restores remote workspaces'
pass 'always policy restores remote workspaces'
"$TMUX" has-session -t '=restore-bad' || fail 'always policy restores every valid local workspace'
pass 'always policy restores every valid local workspace'
assert_equal 2 "$("$TMUX" display-message -p -t '=restore-remote:' '#{window_panes}')" 'remote restoration recreates each pane at the workspace root'
assert_equal "$SOURCE_WINDOWS" "$("$TMUX" list-windows -t '=restore-me:' -F '#{window_name}')" 'restoration preserves tab names and order'
RESTORED_FIRST_WINDOW=$("$TMUX" display-message -p -t '=restore-me:0' '#{window_id}')
assert_equal 3 "$("$TMUX" display-message -p -t "$RESTORED_FIRST_WINDOW" '#{window_panes}')" 'restoration preserves split counts'
assert_equal "$SOURCE_MAIN_GEOMETRY" "$("$TMUX" list-panes -t "$RESTORED_FIRST_WINDOW" -F '#{pane_left},#{pane_top},#{pane_width},#{pane_height}')" 'restoration preserves the exact split layout'
assert_equal "$SOURCE_MAIN_PATHS" "$("$TMUX" list-panes -t "$RESTORED_FIRST_WINDOW" -F '#{pane_current_path}')" 'restoration preserves local pane directories'
assert_equal main "$("$TMUX" display-message -p -t '=restore-me:' '#{window_name}')" 'restoration preserves the active tab'
assert_equal "$SOURCE_ACTIVE_GEOMETRY" "$("$TMUX" display-message -p -t '=restore-me:' '#{pane_left},#{pane_top},#{pane_width},#{pane_height}')" 'restoration preserves the active pane'
"$TMUX" detach-client -t "$RESTORE_CLIENT"
