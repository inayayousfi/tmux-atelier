    CLOSE_CLIENT=$("$TMUX" list-clients -F '#{client_name}' 2>/dev/null | while IFS= read -r CLIENT; do
        [[ $("$TMUX" display-message -p -c "$CLIENT" '#{session_name}') == close-current ]] && printf '%s\n' "$CLIENT"
    done)
    [[ -n $CLOSE_CLIENT ]] && break
    sleep 0.1
done
[[ -n $CLOSE_CLIENT ]] || fail "control client starts for workspace close: $(< "$TEST_ROOT/close-client.log")"
