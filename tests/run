#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TMUX_ATELIER_REAL_TMUX=$(command -v tmux)
TEST_ROOT="$ROOT/.tmp/test.$$"
TEST_BIN="$TEST_ROOT/bin"
STATE_DIR="$TEST_ROOT/state"
LOCAL_ONE="$TEST_ROOT/local one=ok"
LOCAL_TWO="$TEST_ROOT/local two"
SSH_LOG="$TEST_ROOT/ssh.log"
COMMAND_LOG="$TEST_ROOT/tmux-command.log"
WIZARD_HOME="$TEST_ROOT/wizard-home"
WIZARD_CHOICES="$TEST_ROOT/wizard-choices"
WIZARD_FZF_LOG="$TEST_ROOT/wizard-fzf.log"
WIZARD_INPUT_LOG="$TEST_ROOT/wizard-input.log"
TILDE_CHARACTER='~'

export TMUX_ATELIER_TEST_SOCKET="atelier-test-$$"
export TMUX_ATELIER_REAL_TMUX
export TMUX_ATELIER_STATE_DIR="$STATE_DIR"
export TMUX_ATELIER_SSH_LOG="$SSH_LOG"
export TMUX_ATELIER_TMUX="$TEST_BIN/tmux"
export PATH="$TEST_BIN:$PATH"

CLI="$ROOT/bin/tmux-atelier"
TMUX="$TEST_BIN/tmux"
TESTS=0

cleanup() {
    "$TMUX" kill-server >/dev/null 2>&1 || true
    rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

fail() {
    printf 'not ok %d - %s\n' "$TESTS" "$*" >&2
    exit 1
}

pass() {
    ((++TESTS))
    printf 'ok %d - %s\n' "$TESTS" "$1"
}

assert_equal() {
    local expected=$1 actual=$2 message=$3
    [[ $actual == "$expected" ]] || fail "$message (expected '$expected', got '$actual')"
    pass "$message"
}

assert_contains() {
    local value=$1 expected=$2 message=$3
    [[ $value == *"$expected"* ]] || fail "$message (missing '$expected' in '$value')"
    pass "$message"
}

assert_not_contains() {
    local value=$1 unexpected=$2 message=$3
    [[ $value != *"$unexpected"* ]] || fail "$message (unexpected '$unexpected' in '$value')"
    pass "$message"
}

assert_file() {
    [[ -f $1 ]] || fail "$2"
    pass "$2"
}

assert_directory() {
    [[ -d $1 ]] || fail "$2"
    pass "$2"
}

stored_value() {
    local file=$1 wanted=$2 key value
    while IFS='=' read -r key value; do
        [[ $key == "$wanted" ]] && { printf '%s\n' "$value"; return; }
    done < "$file"
}

assert_order() {
    local value=$1 first=$2 second=$3 message=$4
    [[ $value == *"$first"*"$second"* ]] ||
        fail "$message ('$first' does not precede '$second' in '$value')"
    pass "$message"
}

assert_no_file() {
    [[ ! -e $1 ]] || fail "$2"
    pass "$2"
}

assert_fails() {
    local message=$1
    shift
    if "$@" > "$TEST_ROOT/error.log" 2>&1; then
        fail "$message"
    fi
    pass "$message"
}

quote_sh() {
    local value=${1//\'/\'\\\'\'}
    printf "'%s'" "$value"
}

mkdir -p "$TEST_BIN" "$LOCAL_ONE" "$LOCAL_TWO" \
    "$WIZARD_HOME/projects/.hidden/< Back>" "$WIZARD_HOME/.ssh/config.d"
printf 'Include config.d/*\n' > "$WIZARD_HOME/.ssh/config"
printf 'Host included\n  User deploy\n  HostName app.internal\n  Port 2200\n\nHost custom\n' \
    > "$WIZARD_HOME/.ssh/config.d/hosts"
printf 'Host *\n  IdentityAgent ~/.ssh/agent.sock\n' >> "$WIZARD_HOME/.ssh/config"
printf 'not a directory\n' > "$WIZARD_HOME/zzz-file"
cp "$ROOT/tests/fixtures/tmux" "$TEST_BIN/tmux"
cp "$ROOT/tests/fixtures/ssh" "$TEST_BIN/ssh"
chmod +x "$TEST_BIN/tmux" "$TEST_BIN/ssh"

"$CLI" new "local:$LOCAL_ONE" local-one --detached
assert_file "$STATE_DIR/workspaces/local-one" 'local definition is persisted'
assert_equal 600 "$(stat -c '%a' "$STATE_DIR/workspaces/local-one")" 'definition permissions are private'
assert_contains "$(< "$STATE_DIR/workspaces/local-one")" 'path='"$LOCAL_ONE" 'spaces and equals are preserved'
LOCAL_CREATED=$(stored_value "$STATE_DIR/workspaces/local-one" created)
[[ -n $LOCAL_CREATED ]] || fail 'new definitions store their creation order'
pass 'new definitions store their creation order'
assert_equal local "$("$TMUX" show-options -qv -t '=local-one:' @atelier_destination)" 'local destination is stored in tmux'
assert_equal "$LOCAL_ONE" "$("$TMUX" display-message -p -t '=local-one:' '#{pane_current_path}')" 'initial local pane uses workspace path'

"$CLI" window local-one
assert_equal 2 "$("$TMUX" list-windows -t '=local-one' -F '#{window_id}' | wc -l)" 'new window stays in the workspace'
assert_equal "$LOCAL_ONE" "$("$TMUX" display-message -p -t '=local-one:1' '#{pane_current_path}')" 'new local window inherits path'
PANE=$("$TMUX" display-message -p -t '=local-one:1' '#{pane_id}')
"$CLI" split vertical "$PANE"
assert_equal 2 "$("$TMUX" list-panes -t '=local-one:1' -F '#{pane_id}' | wc -l)" 'vertical split is created'
assert_equal 1 "$("$TMUX" list-panes -t '=local-one:1' -F '#{pane_height}' | sort -u | wc -l)" 'vertical split places panes side by side'
while IFS= read -r path; do
    assert_equal "$LOCAL_ONE" "$path" 'local split inherits path'
done < <("$TMUX" list-panes -t '=local-one:1' -F '#{pane_current_path}')
PANE=$("$TMUX" display-message -p -t '=local-one:0' '#{pane_id}')
"$CLI" split horizontal "$PANE"
assert_equal 1 "$("$TMUX" list-panes -t '=local-one:0' -F '#{pane_width}' | sort -u | wc -l)" 'horizontal split stacks panes top and bottom'

assert_fails 'live workspace target cannot be edited' "$CLI" edit local-one "local:$LOCAL_TWO"
"$CLI" close local-one
assert_file "$STATE_DIR/workspaces/local-one" 'closing keeps the definition'
"$CLI" edit local-one "local:$LOCAL_TWO"
assert_equal "$LOCAL_CREATED" "$(stored_value "$STATE_DIR/workspaces/local-one" created)" 'editing preserves workspace order'
"$CLI" open local-one --detached
assert_equal "$LOCAL_TWO" "$("$TMUX" display-message -p -t '=local-one:' '#{pane_current_path}')" 'stopped workspace reopens with edited path'

"$CLI" rename local-one renamed
assert_no_file "$STATE_DIR/workspaces/local-one" 'rename removes old definition'
assert_file "$STATE_DIR/workspaces/renamed" 'rename writes new definition'
assert_equal "$LOCAL_CREATED" "$(stored_value "$STATE_DIR/workspaces/renamed" created)" 'rename preserves workspace order'
"$TMUX" has-session -t '=renamed' || fail 'rename updates live tmux session'
pass 'rename updates live tmux session'

"$CLI" delete renamed
assert_no_file "$STATE_DIR/workspaces/renamed" 'deleting removes only the definition'
"$TMUX" has-session -t '=renamed' || fail 'deleting leaves the session alive'
pass 'deleting leaves the session alive'

assert_fails 'unsafe workspace names are rejected' "$CLI" new "local:$LOCAL_ONE" 'unsafe name' --detached
assert_fails 'newlines in paths are rejected' "$CLI" new $'local:/tmp/bad\npath' newline --detached
assert_fails 'extra arguments prevent destructive commands' "$CLI" close renamed unexpected
"$TMUX" has-session -t '=renamed' || fail 'rejected close leaves the session alive'
pass 'rejected close leaves the session alive'

"$CLI" new "local:$LOCAL_ONE" conflict --detached
"$CLI" close conflict
"$TMUX" new-session -d -s conflict 'sleep 120'
assert_fails 'native session cannot impersonate a saved workspace' "$CLI" open conflict --detached
"$TMUX" kill-session -t '=conflict'

mkdir -p "$TEST_ROOT/project"
"$CLI" new "local:$TEST_ROOT/project" --detached
"$CLI" close project
"$CLI" new "local:$TEST_ROOT/project" --detached
"$CLI" close project-2
assert_file "$STATE_DIR/workspaces/project-2" 'automatic names receive collision suffixes'

printf 'name=legacy-order\ndestination=local\npath=%s\n' "$LOCAL_ONE" \
    > "$STATE_DIR/workspaces/legacy-order"
touch -d '@1' "$STATE_DIR/workspaces/legacy-order"
"$CLI" rename legacy-order legacy-renamed
assert_equal 1 "$(stored_value "$STATE_DIR/workspaces/legacy-renamed" created)" 'legacy definitions inherit their file date'

"$CLI" new "local:$LOCAL_ONE" z-created --detached
"$CLI" close z-created
"$CLI" new "local:$LOCAL_ONE" a-created --detached
"$CLI" close a-created
"$CLI" refresh-status
ORDER_LINE=$("$TMUX" show-options -v -t '=renamed:' 'status-format[1]')
assert_order "$ORDER_LINE" legacy-renamed z-created 'legacy workspaces retain their initial order'
assert_order "$ORDER_LINE" z-created a-created 'new workspaces are appended instead of sorted by name'
Z_CREATED=$(stored_value "$STATE_DIR/workspaces/z-created" created)
"$CLI" rename z-created z-renamed
assert_equal "$Z_CREATED" "$(stored_value "$STATE_DIR/workspaces/z-renamed" created)" 'renamed workspace keeps its creation value'
ORDER_LINE=$("$TMUX" show-options -v -t '=renamed:' 'status-format[1]')
assert_order "$ORDER_LINE" z-renamed a-created 'renamed workspace keeps its status position'

set +e
"$CLI" new "local:$LOCAL_ONE" race --detached > "$TEST_ROOT/race-one.log" 2>&1 &
RACE_ONE=$!
"$CLI" new "local:$LOCAL_ONE" race --detached > "$TEST_ROOT/race-two.log" 2>&1 &
RACE_TWO=$!
wait "$RACE_ONE"; RACE_ONE_STATUS=$?
wait "$RACE_TWO"; RACE_TWO_STATUS=$?
set -e
if ((RACE_ONE_STATUS == 0 && RACE_TWO_STATUS != 0)) ||
   ((RACE_ONE_STATUS != 0 && RACE_TWO_STATUS == 0)); then
    pass 'concurrent creation has exactly one winner'
else
    fail 'concurrent creation has exactly one winner'
fi
assert_file "$STATE_DIR/workspaces/race" 'concurrent creation keeps the winning definition'
"$TMUX" has-session -t '=race' || fail 'concurrent creation keeps the winning session'
pass 'concurrent creation keeps the winning session'

REMOTE_PATH="/srv/app dir/it's"
"$CLI" new "deploy@app:$REMOTE_PATH" remote --detached
sleep 0.1
mapfile -d '' -t SSH_ARGS < "$SSH_LOG"
assert_equal -o "${SSH_ARGS[0]}" 'ssh configures shared connections'
assert_equal ControlMaster=auto "${SSH_ARGS[1]}" 'ssh enables automatic connection sharing'
assert_equal ControlPersist=60 "${SSH_ARGS[3]}" 'ssh keeps an idle master for one minute'
assert_contains "${SSH_ARGS[5]}" 'ControlPath=' 'ssh uses a private control socket'
assert_equal -t "${SSH_ARGS[6]}" 'ssh requests a pseudo-terminal'
assert_equal deploy@app "${SSH_ARGS[7]}" 'ssh receives the OpenSSH destination'
# The fake remote shell, not this test process, expands these variables.
# shellcheck disable=SC2016
REMOTE_INNER='cd -- "$1" && exec "${SHELL:-/bin/sh}" -l'
EXPECTED_REMOTE="sh -c $(quote_sh "$REMOTE_INNER") sh $(quote_sh "$REMOTE_PATH")"
assert_equal "$EXPECTED_REMOTE" "${SSH_ARGS[8]}" 'remote command preserves spaces and apostrophe'
assert_equal deploy@app "$("$TMUX" show-options -qv -t '=remote:' @atelier_destination)" 'remote destination is stored in tmux'

"$CLI" window remote
PANE=$("$TMUX" display-message -p -t '=remote:1' '#{pane_id}')
"$CLI" split horizontal "$PANE"
sleep 0.1
mapfile -d '' -t SSH_ARGS < "$SSH_LOG"
assert_equal 27 "${#SSH_ARGS[@]}" 'remote windows and splits reconnect through shared ssh'

"$TMUX" set-option -g prefix C-Space
"$TMUX" set-option -g status-position top
"$TMUX" set-option -g @atelier_workspace_active_style underscore
"$TMUX" bind-key x display-message user-binding
"$ROOT/tmux-atelier.tmux"
assert_equal C-Space "$("$TMUX" show-options -gv prefix)" 'portable UI preserves the existing prefix'
assert_equal 2 "$("$TMUX" show-options -gv status)" 'status bar has two lines'
assert_equal top "$("$TMUX" show-options -gv status-position)" 'portable UI preserves the status position'
assert_equal on "$("$TMUX" show-options -gv mouse)" 'portable UI enables mouse interactions'
assert_equal prompt "$("$TMUX" show-options -gqv @atelier_restore)" 'portable UI defaults to prompted restoration'
assert_contains "$("$TMUX" list-keys -T prefix | grep -E 'bind-key +(-r +)?-T prefix +x ')" 'user-binding' 'portable UI preserves user key bindings'
assert_contains "$("$TMUX" show-options -v -t '=remote:' 'status-format[1]')" 'underscore' 'portable UI reads configurable workspace styles'

EXAMPLE_CONFIG="$TEST_ROOT/tmux.conf.example"
EXAMPLE_CONTENT=$(< "$ROOT/.tmux.conf.example")
EXAMPLE_CONTENT=${EXAMPLE_CONTENT//\/path\/to\/tmux-atelier/$ROOT}
printf '%s\n' "$EXAMPLE_CONTENT" > "$EXAMPLE_CONFIG"
"$TMUX" source-file "$EXAMPLE_CONFIG"
assert_equal C-a "$("$TMUX" show-options -gv prefix)" 'example config sets the HERDR prefix'
assert_equal bottom "$("$TMUX" show-options -gv status-position)" 'example config places the status bar at the bottom'
assert_contains "$("$TMUX" show-options -v -t '=remote:' 'status-format[1]')" 'remote@app' 'workspace line includes remote destination'
assert_contains "$("$TMUX" show-options -v -t '=remote:' 'status-format[1]')" 'project@local' 'stopped workspace remains in status'
assert_contains "$("$TMUX" show-options -v -t '=remote:' 'status-format[0]')" 'range=window' 'window line is clickable'
assert_contains "$("$TMUX" show-options -v -t '=remote:' 'status-format[0]')" 'range=user|new-tab' 'tab line has a new-tab button'
WINDOW_LINE=$("$TMUX" display-message -p -t '=remote:' "$("$TMUX" show-options -v -t '=remote:' 'status-format[0]')")
FIRST_WINDOW=$("$TMUX" display-message -p -t '=remote:0' '#{window_index} #{window_name}')
assert_contains "$WINDOW_LINE" "$FIRST_WINDOW" 'window line renders the first tab'
assert_contains "$("$TMUX" list-keys -T prefix | grep -E 'bind-key +(-r +)?-T prefix +w ')" 'choose-tree' 'example keeps the native tmux chooser on prefix+w'
assert_contains "$("$TMUX" show-hooks -g client-attached)" 'restore-start' 'client attachment checks for a saved topology'
VERTICAL_BINDING=$("$TMUX" list-keys -T prefix | grep -E 'bind-key +(-r +)?-T prefix +=')
assert_contains "$VERTICAL_BINDING" 'split' 'HERDR vertical split invokes tmux-atelier'
assert_contains "$VERTICAL_BINDING" 'vertical' 'HERDR equals key requests a vertical split'
sleep 10 | env -u TMUX "$TMUX" -C attach-session -t '=remote' > "$TEST_ROOT/control-client.log" 2>&1 &
CONTROL_PID=$!
CONTROL_CLIENT=
for _ in {1..10}; do
    CONTROL_CLIENT=$("$TMUX" list-clients -F '#{client_name}' 2>/dev/null || true)
    [[ -n $CONTROL_CLIENT ]] && break
    sleep 0.1
done
[[ -n $CONTROL_CLIENT ]] || fail "control client starts for key binding test: $(< "$TEST_ROOT/control-client.log")"
PANES_BEFORE=$("$TMUX" list-panes -a -F '#{pane_id}' | wc -l)
"$TMUX" send-keys -K -c "$CONTROL_CLIENT" C-a =
for _ in {1..10}; do
    PANES_AFTER=$("$TMUX" list-panes -a -F '#{pane_id}' | wc -l)
    ((PANES_AFTER == PANES_BEFORE + 1)) && break
    sleep 0.1
done
assert_equal "$((PANES_BEFORE + 1))" "$PANES_AFTER" 'HERDR equals binding creates a pane without opening buffers'
"$TMUX" detach-client -t "$CONTROL_CLIENT"
wait "$CONTROL_PID" 2>/dev/null || true
assert_contains "$("$TMUX" list-keys -T prefix | grep -E 'bind-key +-r +-T prefix +h ')" 'select-pane -L' 'vim h selects the pane on the left'
assert_contains "$("$TMUX" list-keys -T prefix | grep -E 'bind-key +-r +-T prefix +j ')" 'select-pane -D' 'vim j selects the pane below'
assert_contains "$("$TMUX" list-keys -T prefix | grep -E 'bind-key +-r +-T prefix +k ')" 'select-pane -U' 'vim k selects the pane above'
assert_contains "$("$TMUX" list-keys -T prefix | grep -E 'bind-key +-r +-T prefix +l ')" 'select-pane -R' 'vim l selects the pane on the right'
"$TMUX" list-keys -T prefix | grep -F 'popup-new' >/dev/null || fail 'workspace creation popup is bound'
pass 'workspace creation popup is bound'
RELOAD_BINDING=$("$TMUX" list-keys -T prefix | grep -E 'bind-key +(-r +)?-T prefix +r ')
assert_contains "$RELOAD_BINDING" 'tmux-atelier.tmux' 'HERDR r reloads tmux-atelier'
"$TMUX" list-keys -T root | grep -F 'MouseDown1Status' >/dev/null || fail 'left status click is bound'
pass 'left status click is bound'
"$TMUX" list-keys -T root | grep -F 'status-menu' >/dev/null || fail 'right workspace click is bound'
pass 'right workspace click is bound'
RIGHT_CLICK_BINDING=$("$TMUX" list-keys -T root | grep -F 'MouseDown3Status ')
assert_contains "$RIGHT_CLICK_BINDING" 'display-popup' 'right tab click opens a popup'
assert_contains "$RIGHT_CLICK_BINDING" 'popup-tab-menu' 'right tab click opens the FZF action menu'
assert_contains "$RIGHT_CLICK_BINDING" '#{window_id}' 'tab menu receives the clicked window id'
"$TMUX" show-hooks -g session-created | grep -F 'refresh-status' >/dev/null || fail 'session hook refreshes status'
pass 'session hook refreshes status'
"$TMUX" new-session -d -s native-after-plugin 'sleep 120'
for _ in {1..10}; do
    HOOK_STATUS=$("$TMUX" show-options -v -t '=remote:' 'status-format[1]')
    [[ $HOOK_STATUS == *native-after-plugin@tmux* ]] && break
    sleep 0.2
done
assert_contains "$HOOK_STATUS" 'native-after-plugin@tmux' 'session hook executes refresh-status with its argument'
assert_order "$HOOK_STATUS" a-created native-after-plugin 'new native sessions are appended by creation time'

TMUX_ATELIER_COMMAND_LOG="$COMMAND_LOG" \
TMUX_ATELIER_CLI_FOR_TEST="$CLI" \
TMUX_ATELIER_TMUX="$ROOT/tests/fixtures/tmux-log" \
    "$CLI" status-click new test-client
mapfile -d '' -t POPUP_ARGS < "$COMMAND_LOG"
assert_equal display-popup "${POPUP_ARGS[0]}" 'status plus opens a tmux popup'
assert_equal test-client "${POPUP_ARGS[2]}" 'status plus targets the client that clicked'
assert_contains "${POPUP_ARGS[*]}" 'TMUX_ATELIER_CLIENT=test-client' 'status plus passes the originating client'
assert_contains "${POPUP_ARGS[*]}" 'popup-new' 'status plus runs the creation form inside the popup'

: > "$COMMAND_LOG"
TMUX_ATELIER_COMMAND_LOG="$COMMAND_LOG" \
TMUX_ATELIER_CLI_FOR_TEST="$CLI" \
TMUX_ATELIER_TMUX="$ROOT/tests/fixtures/tmux-log" \
    "$CLI" menu workspace test-client
mapfile -d '' -t WORKSPACE_MENU_ARGS < "$COMMAND_LOG"
assert_equal display-popup "${WORKSPACE_MENU_ARGS[0]}" 'right workspace click opens a popup'
assert_contains "${WORKSPACE_MENU_ARGS[*]}" 'popup-workspace-menu' 'workspace popup runs the FZF action menu'

WINDOWS_BEFORE=$("$TMUX" list-windows -t '=remote' -F '#{window_id}' | wc -l)
"$CLI" status-click new-tab '' remote
WINDOWS_AFTER=$("$TMUX" list-windows -t '=remote' -F '#{window_id}' | wc -l)
assert_equal "$((WINDOWS_BEFORE + 1))" "$WINDOWS_AFTER" 'tab plus creates a window on the current workspace target'

"$CLI" new "local:$LOCAL_ONE" tab-order --detached
"$TMUX" move-window -s '=tab-order:0' -t '=tab-order:1'
"$CLI" window tab-order
assert_equal $'1\n2' "$("$TMUX" list-windows -t '=tab-order:' -F '#{window_index}')" 'new tabs append after the highest existing index'
"$TMUX" kill-session -t '=tab-order'
"$CLI" delete tab-order

MENU_FZF_LOG="$TEST_ROOT/menu-fzf.log"
MENU_INPUT_LOG="$TEST_ROOT/menu-input.log"
TMUX_ATELIER_STATE_DIR="$TEST_ROOT/menu-state" \
TMUX_ATELIER_TMUX="$ROOT/tests/fixtures/tmux-ui" \
TMUX_ATELIER_CLI_FOR_TEST="$CLI" \
TMUX_ATELIER_FZF_LOG="$MENU_FZF_LOG" \
TMUX_ATELIER_FZF_INPUT_LOG="$MENU_INPUT_LOG" \
TMUX_ATELIER_FZF_CANCEL=1 \
PATH="$ROOT/tests/fixtures:$PATH" \
    "$CLI" popup-workspace-menu workspace
assert_contains "$(< "$MENU_FZF_LOG")" 'workspace > ' 'workspace actions use FZF'
assert_contains "$(< "$MENU_INPUT_LOG")" 'Rename workspace' 'workspace FZF menu offers rename'
assert_contains "$(< "$MENU_INPUT_LOG")" 'Close workspace' 'workspace FZF menu offers close'

: > "$COMMAND_LOG"
TMUX_ATELIER_STATE_DIR="$TEST_ROOT/menu-state" \
TMUX_ATELIER_COMMAND_LOG="$COMMAND_LOG" \
TMUX_ATELIER_CLI_FOR_TEST="$CLI" \
TMUX_ATELIER_TMUX="$ROOT/tests/fixtures/tmux-log" \
TMUX_ATELIER_FZF_LOG="$MENU_FZF_LOG" \
TMUX_ATELIER_FZF_CHOICE='Rename workspace' \
PATH="$ROOT/tests/fixtures:$PATH" \
    "$CLI" popup-workspace-menu native-session
mapfile -d '' -t DEFERRED_RENAME_ARGS < "$COMMAND_LOG"
assert_contains "${DEFERRED_RENAME_ARGS[*]}" 'run-shell' 'native workspace rename is not mistaken for FZF cancellation'
assert_contains "${DEFERRED_RENAME_ARGS[*]}" 'request-rename' 'native workspace rename schedules its input popup'

: > "$COMMAND_LOG"
TMUX_ATELIER_COMMAND_LOG="$COMMAND_LOG" \
TMUX_ATELIER_CLI_FOR_TEST="$CLI" \
TMUX_ATELIER_TMUX="$ROOT/tests/fixtures/tmux-log" \
    "$CLI" request-rename workspace test-client
mapfile -d '' -t RENAME_PROMPT_ARGS < "$COMMAND_LOG"
assert_equal display-popup "${RENAME_PROMPT_ARGS[0]}" 'workspace rename opens a dedicated input popup'
assert_contains "${RENAME_PROMPT_ARGS[*]}" 'popup-rename' 'workspace rename popup runs the text input form'
assert_contains "${RENAME_PROMPT_ARGS[*]}" 'test-client' 'workspace rename popup targets the originating client'

: > "$COMMAND_LOG"
TMUX_ATELIER_COMMAND_LOG="$COMMAND_LOG" \
TMUX_ATELIER_CLI_FOR_TEST="$CLI" \
TMUX_ATELIER_TMUX="$ROOT/tests/fixtures/tmux-log" \
    "$CLI" request-tab-rename '@2' test-client
mapfile -d '' -t TAB_RENAME_PROMPT_ARGS < "$COMMAND_LOG"
assert_contains "${TAB_RENAME_PROMPT_ARGS[*]}" 'display-popup' 'tab rename opens a dedicated input popup'
assert_contains "${TAB_RENAME_PROMPT_ARGS[*]}" 'popup-tab-rename' 'tab rename popup runs the text input form'
assert_contains "${TAB_RENAME_PROMPT_ARGS[*]}" 'test-client' 'tab rename popup targets the originating client'

: > "$MENU_FZF_LOG"
: > "$MENU_INPUT_LOG"
TMUX_ATELIER_TMUX="$ROOT/tests/fixtures/tmux-ui" \
TMUX_ATELIER_CLI_FOR_TEST="$CLI" \
TMUX_ATELIER_FZF_LOG="$MENU_FZF_LOG" \
TMUX_ATELIER_FZF_INPUT_LOG="$MENU_INPUT_LOG" \
TMUX_ATELIER_FZF_CANCEL=1 \
PATH="$ROOT/tests/fixtures:$PATH" \
    "$CLI" popup-tab-menu '@2'
assert_contains "$(< "$MENU_FZF_LOG")" 'editor > ' 'tab actions use FZF'
assert_contains "$(< "$MENU_INPUT_LOG")" 'Rename tab' 'tab FZF menu offers rename'
assert_contains "$(< "$MENU_INPUT_LOG")" 'Close tab' 'tab FZF menu offers close'

sleep 20 | env -u TMUX "$TMUX" -C attach-session -t '=remote' > "$TEST_ROOT/wizard-client.log" 2>&1 &
WIZARD_CLIENT_PID=$!
WIZARD_CLIENT=
for _ in {1..10}; do
    WIZARD_CLIENT=$("$TMUX" list-clients -F '#{client_name}' 2>/dev/null || true)
    [[ -n $WIZARD_CLIENT ]] && break
    sleep 0.1
done
[[ -n $WIZARD_CLIENT ]] || fail "control client starts for creation wizard: $(< "$TEST_ROOT/wizard-client.log")"

printf '%s\n' $'local\tLocal\tlocal' $'directory\tprojects' $'directory\t.hidden' \
    $'directory\t< Back>' $'select\t< Select this folder>' > "$WIZARD_CHOICES"
printf 'local-wizard\n' | \
    HOME="$WIZARD_HOME" \
    TMUX_ATELIER_CLIENT="$WIZARD_CLIENT" \
    TMUX_ATELIER_FZF_LOG="$WIZARD_FZF_LOG" \
    TMUX_ATELIER_FZF_INPUT_LOG="$WIZARD_INPUT_LOG" \
    TMUX_ATELIER_FZF_CHOICES_FILE="$WIZARD_CHOICES" \
    PATH="$ROOT/tests/fixtures:$PATH" \
    "$CLI" popup-new
assert_contains "$(< "$STATE_DIR/workspaces/local-wizard")" 'destination=local' 'creation wizard creates a local workspace'
assert_contains "$(< "$STATE_DIR/workspaces/local-wizard")" "path=$WIZARD_HOME/projects/.hidden/< Back>" 'directory names cannot collide with browser actions'
assert_contains "$(< "$WIZARD_FZF_LOG")" 'Machine > ' 'creation wizard separates the machine type screen'
assert_contains "$(< "$WIZARD_FZF_LOG")" "$TILDE_CHARACTER/ > " 'local directory browser starts at home'
assert_not_contains "$(< "$WIZARD_INPUT_LOG")" 'zzz-file' 'local browser ignores files without failing'

printf '%s\n' $'local\tLocal\tlocal' '__QUERY__' > "$WIZARD_CHOICES"
printf 'local-created\n' | \
    HOME="$WIZARD_HOME" \
    TMUX_ATELIER_CLIENT="$WIZARD_CLIENT" \
    TMUX_ATELIER_FZF_QUERY="$TILDE_CHARACTER/new/project" \
    TMUX_ATELIER_FZF_LOG="$WIZARD_FZF_LOG" \
    TMUX_ATELIER_FZF_INPUT_LOG="$WIZARD_INPUT_LOG" \
    TMUX_ATELIER_FZF_CHOICES_FILE="$WIZARD_CHOICES" \
    PATH="$ROOT/tests/fixtures:$PATH" \
    "$CLI" popup-new
assert_directory "$WIZARD_HOME/new/project" 'typed local path is created recursively'
assert_contains "$(< "$STATE_DIR/workspaces/local-created")" "path=$WIZARD_HOME/new/project" 'typed local path becomes the workspace target'

: > "$WIZARD_FZF_LOG"
: > "$WIZARD_INPUT_LOG"
printf '%s\n' $'alias\tincluded  deploy@app.internal:2200\tincluded' \
    $'directory\twork dir' $'select\t< Select this folder>' > "$WIZARD_CHOICES"
printf 'remote-wizard\n' | \
    HOME="$WIZARD_HOME" \
    TMUX_ATELIER_CLIENT="$WIZARD_CLIENT" \
    TMUX_ATELIER_FZF_LOG="$WIZARD_FZF_LOG" \
    TMUX_ATELIER_FZF_INPUT_LOG="$WIZARD_INPUT_LOG" \
    TMUX_ATELIER_FZF_CHOICES_FILE="$WIZARD_CHOICES" \
    PATH="$ROOT/tests/fixtures:$PATH" \
    "$CLI" popup-new
assert_contains "$(< "$WIZARD_INPUT_LOG")" 'included  deploy@app.internal:2200' 'machine screen resolves included OpenSSH aliases'
assert_not_contains "$(< "$WIZARD_INPUT_LOG")" 'README.md' 'wildcard SSH hosts do not expand to local files'
assert_contains "$(< "$WIZARD_INPUT_LOG")" '.config' 'remote browser includes hidden directories'
assert_contains "$(< "$STATE_DIR/workspaces/remote-wizard")" 'destination=included' 'remote wizard preserves the selected OpenSSH alias'
assert_contains "$(< "$STATE_DIR/workspaces/remote-wizard")" 'path=/home/remote/work dir' 'remote browser selects a path containing spaces'

printf '%s\n' $'custom\tCustom SSH destination\t' '__QUERY__' > "$WIZARD_CHOICES"
printf 'custom@app\ncustom-wizard\n' | \
    HOME="$WIZARD_HOME" \
    TMUX_ATELIER_CLIENT="$WIZARD_CLIENT" \
    TMUX_ATELIER_REMOTE_CANONICAL='/mnt/data' \
    TMUX_ATELIER_FZF_QUERY='/mnt/data' \
    TMUX_ATELIER_FZF_LOG="$WIZARD_FZF_LOG" \
    TMUX_ATELIER_FZF_INPUT_LOG="$WIZARD_INPUT_LOG" \
    TMUX_ATELIER_FZF_CHOICES_FILE="$WIZARD_CHOICES" \
    PATH="$ROOT/tests/fixtures:$PATH" \
    "$CLI" popup-new
assert_contains "$(< "$STATE_DIR/workspaces/custom-wizard")" 'destination=custom@app' 'remote wizard accepts a custom user and host'
assert_contains "$(< "$STATE_DIR/workspaces/custom-wizard")" 'path=/mnt/data' 'remote wizard accepts and validates an absolute custom path'
mapfile -d '' -t SSH_ARGS < "$SSH_LOG"
assert_contains "${SSH_ARGS[*]}" 'mkdir -p' 'typed remote path is created recursively over SSH'

printf '%s\n' $'alias\tcustom  remote@custom:22\tcustom' \
    $'select\t< Select this folder>' > "$WIZARD_CHOICES"
printf 'alias-custom-wizard\n' | \
    HOME="$WIZARD_HOME" \
    TMUX_ATELIER_CLIENT="$WIZARD_CLIENT" \
    TMUX_ATELIER_FZF_LOG="$WIZARD_FZF_LOG" \
    TMUX_ATELIER_FZF_INPUT_LOG="$WIZARD_INPUT_LOG" \
    TMUX_ATELIER_FZF_CHOICES_FILE="$WIZARD_CHOICES" \
    PATH="$ROOT/tests/fixtures:$PATH" \
    "$CLI" popup-new
assert_contains "$(< "$STATE_DIR/workspaces/alias-custom-wizard")" 'destination=custom' 'OpenSSH aliases cannot collide with remote screen actions'
[[ ! -s $WIZARD_CHOICES ]] || fail 'scripted FZF choices are exhausted exactly'
pass 'scripted FZF choices are exhausted exactly'

"$TMUX" detach-client -t "$WIZARD_CLIENT"
wait "$WIZARD_CLIENT_PID" 2>/dev/null || true

"$TMUX" new-window -d -t '=remote:' 'sleep 120'
assert_equal "$((WINDOWS_AFTER + 1))" "$("$TMUX" list-windows -t '=remote' -F '#{window_id}' | wc -l)" 'native tmux command remains usable'
"$TMUX" display-message -p -t '=remote:' '#{session_name}' >/dev/null || fail 'existing session remains inspectable without invoking scripts'
pass 'existing session remains inspectable without invoking scripts'

"$TMUX" kill-server
RESTORE_STATE="$TEST_ROOT/restore-state"
RESTORE_ROOT="$TEST_ROOT/restore-root"
RESTORE_SUB_ONE="$RESTORE_ROOT/source"
RESTORE_SUB_TWO="$RESTORE_ROOT/tests"
RESTORE_BAD_ROOT="$TEST_ROOT/restore-bad-root"
mkdir -p "$RESTORE_SUB_ONE" "$RESTORE_SUB_TWO" "$RESTORE_BAD_ROOT"
export TMUX_ATELIER_STATE_DIR="$RESTORE_STATE"
export TMUX_ATELIER_TEST_SOCKET="atelier-restore-source-$$"

"$CLI" new "local:$RESTORE_ROOT" restore-me --detached
RESTORE_FIRST_WINDOW=$("$TMUX" display-message -p -t '=restore-me:' '#{window_id}')
RESTORE_FIRST_PANE=$("$TMUX" display-message -p -t "$RESTORE_FIRST_WINDOW" '#{pane_id}')
"$TMUX" rename-window -t "$RESTORE_FIRST_WINDOW" main
"$TMUX" split-window -d -h -t "$RESTORE_FIRST_PANE" -c "$RESTORE_SUB_ONE"
"$TMUX" split-window -d -v -t "$RESTORE_FIRST_PANE" -c "$RESTORE_SUB_TWO"
"$CLI" window restore-me
RESTORE_SECOND_WINDOW=$("$TMUX" display-message -p -t '=restore-me:' '#{window_id}')
"$TMUX" rename-window -t "$RESTORE_SECOND_WINDOW" checks
"$TMUX" split-window -d -h -t "$RESTORE_SECOND_WINDOW" -c "$RESTORE_SUB_ONE"
"$TMUX" select-window -t "$RESTORE_FIRST_WINDOW"
mapfile -t RESTORE_SOURCE_PANES < <("$TMUX" list-panes -t "$RESTORE_FIRST_WINDOW" -F '#{pane_id}')
"$TMUX" select-pane -t "${RESTORE_SOURCE_PANES[1]}"
"$CLI" new 'remote@app:/srv/restore' restore-remote --detached
RESTORE_REMOTE_PANE=$("$TMUX" display-message -p -t '=restore-remote:' '#{pane_id}')
"$CLI" split vertical "$RESTORE_REMOTE_PANE"
"$CLI" new "local:$RESTORE_BAD_ROOT" restore-bad --detached
"$CLI" snapshot
RESTORE_SNAPSHOT_PIDS=()
for _ in {1..8}; do
    "$CLI" snapshot &
    RESTORE_SNAPSHOT_PIDS+=("$!")
done
for RESTORE_SNAPSHOT_PID in "${RESTORE_SNAPSHOT_PIDS[@]}"; do
    wait "$RESTORE_SNAPSHOT_PID"
done
assert_file "$RESTORE_STATE/restore.snapshot" 'open workspace topology is persisted'
[[ ! -d $RESTORE_STATE/.snapshot.lock ]] || fail 'concurrent snapshots release their serialization lock'
pass 'concurrent snapshots are serialized and release their lock'
assert_equal 600 "$(stat -c '%a' "$RESTORE_STATE/restore.snapshot")" 'restore snapshot permissions are private'
SOURCE_WINDOWS=$("$TMUX" list-windows -t '=restore-me:' -F '#{window_name}')
SOURCE_MAIN_GEOMETRY=$("$TMUX" list-panes -t "$RESTORE_FIRST_WINDOW" -F '#{pane_left},#{pane_top},#{pane_width},#{pane_height}')
SOURCE_MAIN_PATHS=$("$TMUX" list-panes -t "$RESTORE_FIRST_WINDOW" -F '#{pane_current_path}')
SOURCE_ACTIVE_GEOMETRY=$("$TMUX" display-message -p -t "${RESTORE_SOURCE_PANES[1]}" '#{pane_left},#{pane_top},#{pane_width},#{pane_height}')
cp "$RESTORE_STATE/restore.snapshot" "$TEST_ROOT/valid-restore.snapshot"
"$TMUX" kill-server

export TMUX_ATELIER_TEST_SOCKET="atelier-restore-always-$$"
"$TMUX" new-session -d -s bootstrap 'sleep 120'
"$TMUX" set-option -g @atelier_restore always
"$CLI" restore-arm
assert_equal 1 "$("$TMUX" show-options -gqv @atelier_restore_pending)" 'saved topology arms restoration on a fresh server'
"$CLI" restore-start
"$TMUX" has-session -t '=restore-me' || fail 'always policy restores the saved workspace'
pass 'always policy restores the saved workspace'
"$TMUX" has-session -t '=restore-remote' || fail 'always policy restores remote workspaces'
pass 'always policy restores remote workspaces'
"$TMUX" has-session -t '=restore-bad' || fail 'always policy restores every valid local workspace'
pass 'always policy restores every valid local workspace'
assert_equal 2 "$("$TMUX" display-message -p -t '=restore-remote:' '#{window_panes}')" 'remote restoration recreates each pane at the workspace root'
assert_equal "$SOURCE_WINDOWS" "$("$TMUX" list-windows -t '=restore-me:' -F '#{window_name}')" 'restoration preserves tab names and order'
RESTORED_FIRST_WINDOW=$("$TMUX" display-message -p -t '=restore-me:0' '#{window_id}')
assert_equal 3 "$("$TMUX" display-message -p -t "$RESTORED_FIRST_WINDOW" '#{window_panes}')" 'restoration preserves split counts'
assert_equal "$SOURCE_MAIN_GEOMETRY" "$("$TMUX" list-panes -t "$RESTORED_FIRST_WINDOW" -F '#{pane_left},#{pane_top},#{pane_width},#{pane_height}')" 'restoration preserves the exact split layout'
assert_equal "$SOURCE_MAIN_PATHS" "$("$TMUX" list-panes -t "$RESTORED_FIRST_WINDOW" -F '#{pane_current_path}')" 'restoration preserves local pane directories'
assert_equal main "$("$TMUX" display-message -p -t '=restore-me:' '#{window_name}')" 'restoration preserves the active tab'
assert_equal "$SOURCE_ACTIVE_GEOMETRY" "$("$TMUX" display-message -p -t '=restore-me:' '#{pane_left},#{pane_top},#{pane_width},#{pane_height}')" 'restoration preserves the active pane'
"$TMUX" kill-server

cp "$TEST_ROOT/valid-restore.snapshot" "$RESTORE_STATE/restore.snapshot"
export TMUX_ATELIER_TEST_SOCKET="atelier-restore-prompt-$$"
"$TMUX" new-session -d -s bootstrap 'sleep 120'
"$TMUX" set-option -g @atelier_restore prompt
"$CLI" restore-arm
printf 'n' | "$CLI" popup-restore
assert_fails 'declining restoration leaves workspaces closed' "$TMUX" has-session -t '=restore-me'
assert_no_file "$RESTORE_STATE/restore.snapshot" 'declining restoration replaces the old snapshot'
"$TMUX" kill-server

cp "$TEST_ROOT/valid-restore.snapshot" "$RESTORE_STATE/restore.snapshot"
export TMUX_ATELIER_TEST_SOCKET="atelier-restore-never-$$"
"$TMUX" new-session -d -s bootstrap 'sleep 120'
"$TMUX" set-option -g @atelier_restore never
"$CLI" restore-arm
"$CLI" restore-start
assert_fails 'never policy leaves saved workspaces closed' "$TMUX" has-session -t '=restore-me'
assert_no_file "$RESTORE_STATE/restore.snapshot" 'never policy replaces the old snapshot'
"$TMUX" kill-server

printf 'invalid\0snapshot\0' > "$RESTORE_STATE/restore.snapshot"
export TMUX_ATELIER_TEST_SOCKET="atelier-restore-invalid-$$"
"$TMUX" new-session -d -s bootstrap 'sleep 120'
"$TMUX" set-option -g @atelier_restore always
"$CLI" restore-arm
assert_fails 'invalid snapshots fail before creating sessions' "$CLI" restore-start
assert_fails 'invalid snapshots do not create managed sessions' "$TMUX" has-session -t '=restore-me'
"$TMUX" kill-server

cp "$TEST_ROOT/valid-restore.snapshot" "$RESTORE_STATE/restore.snapshot"
rm -f "$RESTORE_STATE/workspaces/restore-me"
export TMUX_ATELIER_TEST_SOCKET="atelier-restore-missing-$$"
"$TMUX" new-session -d -s bootstrap 'sleep 120'
"$TMUX" set-option -g @atelier_restore always
"$CLI" restore-arm
"$CLI" restore-start
assert_fails 'restoration skips workspaces whose definitions were removed' "$TMUX" has-session -t '=restore-me'
"$TMUX" kill-server

cp "$TEST_ROOT/valid-restore.snapshot" "$RESTORE_STATE/restore.snapshot"
rm -rf "$RESTORE_BAD_ROOT"
export TMUX_ATELIER_TEST_SOCKET="atelier-restore-failure-$$"
"$TMUX" new-session -d -s bootstrap 'sleep 120'
"$TMUX" set-option -g @atelier_restore always
"$CLI" restore-arm
assert_fails 'runtime restore failures are reported' "$CLI" restore-start
assert_fails 'runtime failures roll back earlier restored sessions' "$TMUX" has-session -t '=restore-remote'
assert_equal 1 "$("$TMUX" show-options -gqv @atelier_restore_pending)" 'runtime failures keep the snapshot pending'
assert_equal 0 "$("$TMUX" show-options -gqv @atelier_restore_handled)" 'runtime failures allow a later retry'
"$TMUX" set-option -g @atelier_restore prompt
assert_fails 'a missing prompt client is reported' "$CLI" restore-start missing-client
assert_equal 1 "$("$TMUX" show-options -gqv @atelier_restore_pending)" 'prompt launch failures keep the snapshot pending'
assert_equal 0 "$("$TMUX" show-options -gqv @atelier_restore_handled)" 'prompt launch failures allow another attachment to retry'

printf '1..%d\n' "$TESTS"
