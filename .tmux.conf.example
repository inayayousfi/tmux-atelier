# Configure tmux-atelier before loading it. Replace the path below with the
# absolute path to this repository.

# Startup restoration: prompt, always, or never.
set-option -g @atelier_restore prompt

# Separators shown between workspaces and tabs.
set-option -g @atelier_separator '│'
set-option -g @atelier_tab_separator '│'

run-shell /path/to/tmux-atelier/tmux-atelier.tmux
