#!/usr/bin/env bash

set -euo pipefail

readonly TMUX_BIN="${TMUX_ATELIER_TMUX:-tmux}"
readonly STATE_ROOT="${TMUX_ATELIER_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-atelier}"
readonly WORKSPACES_DIR="$STATE_ROOT/workspaces"
readonly DEBUG_LOG="${TMUX_ATELIER_DEBUG_LOG:-$STATE_ROOT/debug.log}"
readonly RESTORE_FILE="$STATE_ROOT/restore.snapshot"
readonly SNAPSHOT_LOCK="$STATE_ROOT/.snapshot.lock"
readonly ADOPTION_LOCK="$STATE_ROOT/.adoption.lock"

WORKSPACE_NAME=
WORKSPACE_DESTINATION=
WORKSPACE_PATH=
WORKSPACE_CREATED=
SNAPSHOT_TOKEN=
RESTORE_ACTIVE=
declare -A SSH_CONFIG_SEEN=()
declare -a SSH_COMMON_ARGS=()

die() {
    printf 'tmux-atelier: %s\n' "$*" >&2
    exit 1
}

debug_log() {
    local message=$1
    mkdir -p "$STATE_ROOT"
    chmod 700 "$STATE_ROOT"
    touch "$DEBUG_LOG"
    chmod 600 "$DEBUG_LOG"
    printf '%(%Y-%m-%dT%H:%M:%S%z)T pid=%s pane=%q client=%q %s\n' \
        -1 "$$" "${TMUX_PANE:-}" "${TMUX_ATELIER_CLIENT:-}" "$message" >> "$DEBUG_LOG"
}

tmux_cmd() {
    "$TMUX_BIN" "$@"
}

validate_name() {
    [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid workspace name: $1"
}

validate_value() {
    local label=$1 value=$2
    [[ -n $value ]] || die "$label must not be empty"
    [[ $value != *$'\n'* && $value != *$'\r'* ]] || die "$label must not contain a newline"
}

validate_destination() {
    validate_value destination "$1"
    [[ $1 == local || $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.@-]*$ ]] ||
        die "invalid OpenSSH destination: $1"
}

workspace_file() {
    validate_name "$1"
    printf '%s/%s\n' "$WORKSPACES_DIR" "$1"
}

read_workspace() {
    local name=$1 file key value
    local seen_name=0 seen_destination=0 seen_path=0 seen_created=0

    file=$(workspace_file "$name")
    [[ -f $file ]] || die "workspace not found: $name"

    WORKSPACE_NAME=
    WORKSPACE_DESTINATION=
    WORKSPACE_PATH=
    WORKSPACE_CREATED=
    while IFS='=' read -r key value || [[ -n $key ]]; do
        case $key in
            name)
                ((seen_name == 0)) || die "duplicate name in workspace: $name"
                WORKSPACE_NAME=$value
                seen_name=1
                ;;
            destination)
                ((seen_destination == 0)) || die "duplicate destination in workspace: $name"
                WORKSPACE_DESTINATION=$value
                seen_destination=1
                ;;
            path)
                ((seen_path == 0)) || die "duplicate path in workspace: $name"
                WORKSPACE_PATH=$value
                seen_path=1
                ;;
            created)
                ((seen_created == 0)) || die "duplicate creation time in workspace: $name"
                WORKSPACE_CREATED=$value
                seen_created=1
                ;;
            ''|'#'*) ;;
        esac
    done < "$file"

    ((seen_name && seen_destination && seen_path)) || die "incomplete workspace: $name"
    [[ $WORKSPACE_NAME == "$name" ]] || die "workspace name does not match its filename: $name"
    validate_name "$WORKSPACE_NAME"
    validate_destination "$WORKSPACE_DESTINATION"
    validate_value path "$WORKSPACE_PATH"
    if ((seen_created)); then
        [[ $WORKSPACE_CREATED =~ ^[0-9]+([.][0-9]+)?$ ]] ||
            die "invalid creation time in workspace: $name"
    else
        WORKSPACE_CREATED=$(stat -c '%Y' "$file")
    fi
}

write_workspace() {
    local name=$1 destination=$2 path=$3 mode=${4:-replace} created=${5:-} file temporary
    validate_name "$name"
    validate_destination "$destination"
    validate_value path "$path"
    [[ -n $created ]] || created=$(date +%s.%N)
    [[ $created =~ ^[0-9]+([.][0-9]+)?$ ]] || die "invalid creation time: $created"

    mkdir -p "$WORKSPACES_DIR" || return 1
    chmod 700 "$WORKSPACES_DIR" || return 1
    file=$(workspace_file "$name")
    temporary=$(mktemp "$WORKSPACES_DIR/.${name}.XXXXXX") || return 1
    chmod 600 "$temporary" || { rm -f "$temporary"; return 1; }
    if ! printf 'name=%s\ndestination=%s\npath=%s\ncreated=%s\n' \
        "$name" "$destination" "$path" "$created" > "$temporary"; then
        rm -f "$temporary"
        return 1
    fi
    if [[ $mode == create ]]; then
        if ! ln "$temporary" "$file" 2>/dev/null; then
            rm -f "$temporary"
            return 1
        fi
        rm -f "$temporary"
    else
        mv -f "$temporary" "$file"
    fi
}

parse_target() {
    local target=$1
    [[ $target == *:* ]] || die "target must use destination:path"
    WORKSPACE_DESTINATION=${target%%:*}
    WORKSPACE_PATH=${target#*:}
    validate_destination "$WORKSPACE_DESTINATION"
    validate_value path "$WORKSPACE_PATH"
}

normalise_name() {
    local path=$1 excluded_session=${2:-} candidate base suffix=2
    base=${path%/}
    base=${base##*/}
    [[ -n $base && $base != '.' && $base != '~' ]] || base=workspace
    candidate=${base//[^A-Za-z0-9_-]/-}
    candidate=${candidate#-}
    candidate=${candidate%-}
    [[ -n $candidate ]] || candidate=workspace
    base=$candidate
    while [[ -e $WORKSPACES_DIR/$candidate ]] ||
        { [[ $candidate != "$excluded_session" ]] && session_exists "$candidate"; }; do
        candidate="$base-$suffix"
        ((suffix++))
    done
    printf '%s\n' "$candidate"
}

session_exists() {
    tmux_cmd has-session -t "=$1" 2>/dev/null
}

session_option() {
    tmux_cmd show-options -qv -t "=$1:" "$2" 2>/dev/null || true
}

quote_sh() {
    local value=${1//\'/\'\\\'\'}
    printf "'%s'" "$value"
}

prepare_ssh_args() {
    local control_dir="$STATE_ROOT/ssh"
    mkdir -p "$control_dir"
    chmod 700 "$control_dir"
    SSH_COMMON_ARGS=(
        -o ControlMaster=auto
        -o ControlPersist=60
        -o "ControlPath=$control_dir/%C"
    )
}

ssh_cmd() {
    local destination=$1
    shift
    prepare_ssh_args
    # Remaining arguments are remote commands and must be expanded by OpenSSH.
    # shellcheck disable=SC2029
    ssh "${SSH_COMMON_ARGS[@]}" "$destination" "$@"
}

remote_shell_command() {
    local destination=$1 path=$2 remote command inner argument
    # $1 and $SHELL are intentionally expanded by the remote POSIX shell.
    # shellcheck disable=SC2016
    inner='cd -- "$1" && exec "${SHELL:-/bin/sh}" -l'
    remote="sh -c $(quote_sh "$inner") sh $(quote_sh "$path")"
    prepare_ssh_args
    command='exec ssh'
    for argument in "${SSH_COMMON_ARGS[@]}"; do
        command+=" $(quote_sh "$argument")"
    done
    command+=" -t $(quote_sh "$destination") $(quote_sh "$remote")"
    printf '%s\n' "$command"
}

mark_session() {
    local name=$1 destination=$2 path=$3
    tmux_cmd set-option -q -t "=$name:" @atelier_managed 1
    tmux_cmd set-option -q -t "=$name:" @atelier_destination "$destination"
    tmux_cmd set-option -q -t "=$name:" @atelier_path "$path"
}

create_session() {
    local name=$1 destination=$2 path=$3 initial_path=${4:-$3} command
    if [[ $destination == local ]]; then
        [[ -d $path ]] || die "local path is not a directory: $path"
        [[ -d $initial_path ]] || initial_path=$path
        tmux_cmd new-session -d -s "$name" -c "$initial_path" || return 1
    else
        command=$(remote_shell_command "$destination" "$path")
        tmux_cmd new-session -d -s "$name" "$command" || return 1
    fi
    if ! mark_session "$name" "$destination" "$path"; then
        tmux_cmd kill-session -t "=$name" 2>/dev/null || true
        return 1
    fi
}

workspace_for_local_path() {
    local wanted=$1 name candidate
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        read_workspace "$name"
        [[ $WORKSPACE_DESTINATION == local ]] || continue
        candidate=$(canonical_local_path "$WORKSPACE_PATH" 2>/dev/null || true)
        [[ $candidate == "$wanted" ]] && { printf '%s\n' "$name"; return; }
    done < <(definition_names)
    return 0
}

client_for_session() {
    local wanted=$1 client session
    while IFS=$'\t' read -r session client; do
        [[ $session == "$wanted" ]] && { printf '%s\n' "$client"; return; }
    done < <(tmux_cmd list-clients -F $'#{session_name}\t#{client_name}' 2>/dev/null || true)
    return 0
}

adopt_session() {
    local session=${1:-} client=${2:-} pending path existing name old
    [[ -n $session ]] || return 0
    session_exists "$session" || return 0
    [[ $(session_option "$session" @atelier_managed) != 1 ]] || return 0
    pending=$(tmux_cmd show-options -gqv @atelier_restore_pending 2>/dev/null || true)
    [[ $pending != 1 ]] || { debug_log "session adoption deferred session=$session restore=pending"; return; }
    path=$(tmux_cmd display-message -p -t "=$session:" '#{pane_current_path}')
    path=$(canonical_local_path "$path") || {
        debug_log "session adoption skipped session=$session reason=invalid-cwd"
        return 0
    }
    if [[ -z $client ]]; then
        client=$(client_for_session "$session")
    fi
    existing=$(workspace_for_local_path "$path")
    if [[ -n $existing && $existing != "$session" ]] && session_exists "$existing"; then
        [[ -z $client ]] || tmux_cmd switch-client -c "$client" -t "=$existing"
        tmux_cmd kill-session -t "=$session"
        debug_log "session adoption reused=$existing removed=$session path=$(printf '%q' "$path")"
        command_snapshot
        refresh_status_if_running
        return 0
    fi

    old=$session
    if [[ -n $existing ]]; then
        name=$existing
    else
        name=$(normalise_name "$path" "$session")
        write_workspace "$name" local "$path" create || die "could not save adopted workspace: $name"
    fi
    if [[ $session != "$name" ]]; then
        if ! tmux_cmd rename-session -t "=$session" "$name"; then
            [[ -n $existing ]] || rm -f "$(workspace_file "$name")"
            return 1
        fi
        session=$name
    fi
    if ! mark_session "$session" local "$path"; then
        [[ $session == "$old" ]] || tmux_cmd rename-session -t "=$session" "$old" 2>/dev/null || true
        [[ -n $existing ]] || rm -f "$(workspace_file "$name")"
        return 1
    fi
    debug_log "session adopted old=$old workspace=$name path=$(printf '%q' "$path")"
    command_snapshot
    refresh_status_if_running
}

command_adopt_session() {
    local attempt acquired=0
    mkdir -p "$STATE_ROOT"
    chmod 700 "$STATE_ROOT"
    for ((attempt = 0; attempt < 500; ++attempt)); do
        if mkdir "$ADOPTION_LOCK" 2>/dev/null; then
            acquired=1
            break
        fi
        sleep 0.01
    done
    ((acquired)) || die 'could not acquire session adoption lock'
    (
        trap 'rmdir "$ADOPTION_LOCK"' EXIT
        adopt_session "$@"
    )
}

snapshot_field() {
    printf '%s\0' "$1" >&3
}

write_snapshot() {
    local exclude_session=${1:-} exclude_window=${2:-}
    local pending temporary session activity active_activity=-1
    local window pane path active_window active_pane pane_ordinal
    local candidate
    local -a sessions=() windows panes filtered_windows

    pending=$(tmux_cmd show-options -gqv @atelier_restore_pending 2>/dev/null || true)
    [[ $pending != 1 ]] || return 0

    while IFS= read -r session; do
        [[ -n $session ]] || continue
        [[ $(session_option "$session" @atelier_managed) == 1 ]] || continue
        [[ -f $(workspace_file "$session") ]] || continue
        [[ $session != "$exclude_session" ]] || continue
        sessions+=("$session")
        activity=$(tmux_cmd display-message -p -t "=$session:" '#{session_activity}')
        if ((activity > active_activity)); then
            RESTORE_ACTIVE=$session
            active_activity=$activity
        fi
    done < <(session_names)

    if ((${#sessions[@]} == 0)); then
        rm -f "$RESTORE_FILE"
        return 0
    fi

    mkdir -p "$STATE_ROOT"
    chmod 700 "$STATE_ROOT"
    temporary=$(mktemp "$STATE_ROOT/.restore.XXXXXX") || return 1
    chmod 600 "$temporary" || { rm -f "$temporary"; return 1; }

    if ! (
        exec 3> "$temporary"
        snapshot_field tmux-atelier-restore
        snapshot_field 1
        snapshot_field active
        snapshot_field "$RESTORE_ACTIVE"
        for session in "${sessions[@]}"; do
            active_window=$(tmux_cmd display-message -p -t "=$session:" '#{window_index}')
            mapfile -t windows < <(tmux_cmd list-windows -t "=$session:" -F '#{window_id}')
            filtered_windows=()
            for candidate in "${windows[@]}"; do
                [[ $candidate == "$exclude_window" ]] || filtered_windows+=("$candidate")
            done
            ((${#filtered_windows[@]} > 0)) || continue
            if [[ -n $exclude_window &&
                $exclude_window == "$(tmux_cmd display-message -p -t "=$session:$active_window" '#{window_id}')" ]]; then
                active_window=$(tmux_cmd display-message -p -t "${filtered_windows[0]}" '#{window_index}')
            fi
            snapshot_field workspace
            snapshot_field "$session"
            snapshot_field "$active_window"
            for window in "${filtered_windows[@]}"; do
                snapshot_field window
                snapshot_field "$(tmux_cmd display-message -p -t "$window" '#{window_index}')"
                snapshot_field "$(tmux_cmd display-message -p -t "$window" '#{window_name}')"
                snapshot_field "$(tmux_cmd display-message -p -t "$window" '#{window_layout}')"
                mapfile -t panes < <(tmux_cmd list-panes -t "$window" -F '#{pane_id}')
                snapshot_field "${#panes[@]}"
                active_pane=0
                pane_ordinal=0
                for pane in "${panes[@]}"; do
                    [[ $(tmux_cmd display-message -p -t "$pane" '#{pane_active}') == 1 ]] &&
                        active_pane=$pane_ordinal
                    ((++pane_ordinal))
                done
                snapshot_field "$active_pane"
                for pane in "${panes[@]}"; do
                    path=
                    if [[ $(session_option "$session" @atelier_destination) == local ]]; then
                        path=$(tmux_cmd display-message -p -t "$pane" '#{pane_current_path}')
                    fi
                    snapshot_field pane
                    snapshot_field "$path"
                done
                snapshot_field end-window
            done
            snapshot_field end-workspace
        done
        snapshot_field end
        exec 3>&-
    ); then
        rm -f "$temporary"
        return 1
    fi
    mv -f "$temporary" "$RESTORE_FILE"
}

command_snapshot() {
    local attempt acquired=0
    mkdir -p "$STATE_ROOT"
    chmod 700 "$STATE_ROOT"
    for ((attempt = 0; attempt < 500; ++attempt)); do
        if mkdir "$SNAPSHOT_LOCK" 2>/dev/null; then
            acquired=1
            break
        fi
        sleep 0.01
    done
    ((acquired)) || die 'could not acquire snapshot lock'
    (
        trap 'rmdir "$SNAPSHOT_LOCK"' EXIT
        write_snapshot "$@"
    )
}

snapshot_read() {
    IFS= read -r -d '' SNAPSHOT_TOKEN <&3
}

snapshot_expect() {
    snapshot_read && [[ $SNAPSHOT_TOKEN == "$1" ]]
}

validate_snapshot() (
    local active name active_window window_index window_name layout pane_count active_pane path i
    local workspace_total=0 window_total=0 pane_total=0
    declare -A workspaces=() windows=()
    [[ -f $RESTORE_FILE ]] || return 1
    exec 3< "$RESTORE_FILE"
    snapshot_expect tmux-atelier-restore || return 1
    snapshot_expect 1 || return 1
    snapshot_expect active || return 1
    snapshot_read || return 1
    [[ -z $SNAPSHOT_TOKEN || $SNAPSHOT_TOKEN =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]] || return 1
    active=$SNAPSHOT_TOKEN

    while snapshot_read; do
        if [[ $SNAPSHOT_TOKEN == end ]]; then
            snapshot_read && return 1
            [[ -n ${workspaces[$active]:-} ]] || return 1
            printf '%s\t%s\t%s\t%s\n' "$active" "$workspace_total" "$window_total" "$pane_total"
            return 0
        fi
        [[ $SNAPSHOT_TOKEN == workspace ]] || return 1
        ((++workspace_total))
        snapshot_read || return 1; name=$SNAPSHOT_TOKEN
        [[ $name =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ && -z ${workspaces[$name]:-} ]] || return 1
        workspaces[$name]=1
        snapshot_read || return 1; active_window=$SNAPSHOT_TOKEN
        [[ $active_window =~ ^[0-9]+$ ]] || return 1
        windows=()

        while snapshot_read; do
            [[ $SNAPSHOT_TOKEN != end-workspace ]] || break
            [[ $SNAPSHOT_TOKEN == window ]] || return 1
            ((++window_total))
            snapshot_read || return 1; window_index=$SNAPSHOT_TOKEN
            [[ $window_index =~ ^[0-9]+$ && -z ${windows[$window_index]:-} ]] || return 1
            windows[$window_index]=1
            snapshot_read || return 1; window_name=$SNAPSHOT_TOKEN
            [[ $window_name != *$'\n'* ]] || return 1
            snapshot_read || return 1; layout=$SNAPSHOT_TOKEN
            [[ -n $layout && $layout != *$'\n'* ]] || return 1
            snapshot_read || return 1; pane_count=$SNAPSHOT_TOKEN
            [[ $pane_count =~ ^[1-9][0-9]*$ ]] || return 1
            ((pane_total += 10#$pane_count))
            snapshot_read || return 1; active_pane=$SNAPSHOT_TOKEN
            [[ $active_pane =~ ^[0-9]+$ ]] || return 1
            ((10#$active_pane < 10#$pane_count)) || return 1
            for ((i = 0; i < 10#$pane_count; ++i)); do
                snapshot_expect pane || return 1
                snapshot_read || return 1; path=$SNAPSHOT_TOKEN
            done
            snapshot_expect end-window || return 1
        done
        ((${#windows[@]} > 0)) || return 1
        [[ -n ${windows[$active_window]:-} ]] || return 1
    done
    return 1
)

create_restore_window() {
    local session=$1 destination=$2 root=$3 initial_path=$4 command
    if [[ $destination == local ]]; then
        [[ -d $initial_path ]] || initial_path=$root
        tmux_cmd new-window -a -d -P -F '#{window_id}' -t "=$session:{end}" -c "$initial_path"
    else
        command=$(remote_shell_command "$destination" "$root")
        tmux_cmd new-window -a -d -P -F '#{window_id}' -t "=$session:{end}" "$command"
    fi
}

create_restore_pane() {
    local window=$1 destination=$2 root=$3 path=$4 command
    if [[ $destination == local ]]; then
        [[ -d $path ]] || path=$root
        tmux_cmd split-window -d -t "$window" -c "$path"
    else
        command=$(remote_shell_command "$destination" "$root")
        tmux_cmd split-window -d -t "$window" "$command"
    fi
}

restore_snapshot_data() {
    local created_file=$1 active name active_window window_index window_name layout pane_count active_pane
    local destination root window restored_active_window path i skip first_window
    local -a paths panes
    exec 3< "$RESTORE_FILE"
    snapshot_expect tmux-atelier-restore
    snapshot_expect 1
    snapshot_expect active
    snapshot_read; active=$SNAPSHOT_TOKEN
    RESTORE_ACTIVE=$active

    while snapshot_read && [[ $SNAPSHOT_TOKEN != end ]]; do
        snapshot_read; name=$SNAPSHOT_TOKEN
        snapshot_read; active_window=$SNAPSHOT_TOKEN
        skip=0
        first_window=1
        restored_active_window=
        if session_exists "$name" || [[ ! -f $(workspace_file "$name") ]]; then
            skip=1
        else
            read_workspace "$name"
            destination=$WORKSPACE_DESTINATION
            root=$WORKSPACE_PATH
        fi

        while snapshot_read && [[ $SNAPSHOT_TOKEN != end-workspace ]]; do
            snapshot_read; window_index=$SNAPSHOT_TOKEN
            snapshot_read; window_name=$SNAPSHOT_TOKEN
            snapshot_read; layout=$SNAPSHOT_TOKEN
            snapshot_read; pane_count=$SNAPSHOT_TOKEN
            snapshot_read; active_pane=$SNAPSHOT_TOKEN
            paths=()
            for ((i = 0; i < 10#$pane_count; ++i)); do
                snapshot_expect pane
                snapshot_read; paths+=("$SNAPSHOT_TOKEN")
            done
            snapshot_expect end-window
            ((skip)) && continue

            if ((first_window)); then
                printf '%s\n' "$name" >> "$created_file"
                create_session "$name" "$destination" "$root" "${paths[0]}"
                window=$(tmux_cmd display-message -p -t "=$name:" '#{window_id}')
                first_window=0
            else
                window=$(create_restore_window "$name" "$destination" "$root" "${paths[0]}")
            fi
            for ((i = 1; i < 10#$pane_count; ++i)); do
                create_restore_pane "$window" "$destination" "$root" "${paths[$i]}"
            done
            tmux_cmd select-layout -t "$window" "$layout" >/dev/null
            tmux_cmd rename-window -t "$window" "$window_name"
            mapfile -t panes < <(tmux_cmd list-panes -t "$window" -F '#{pane_id}')
            if [[ $destination == local ]]; then
                for ((i = 0; i < 10#$pane_count; ++i)); do
                    path=${paths[$i]}
                    [[ -d $path ]] || path=$root
                    tmux_cmd respawn-pane -k -t "${panes[$i]}" -c "$path"
                done
            fi
            tmux_cmd select-pane -t "${panes[10#$active_pane]}"
            [[ $window_index != "$active_window" ]] || restored_active_window=$window
        done
        ((skip)) || tmux_cmd select-window -t "$restored_active_window"
    done
}

command_restore_discard() {
    local client=${1:-} session
    debug_log 'restore discarded; starting fresh'
    rm -f "$RESTORE_FILE"
    tmux_cmd set-option -gq @atelier_restore_pending 0
    tmux_cmd set-option -gq @atelier_restore_handled 1
    command_snapshot
    if [[ -n $client ]]; then
        session=$(tmux_cmd display-message -p -c "$client" '#{session_name}' 2>/dev/null || true)
        [[ -z $session ]] || command_adopt_session "$session" "$client"
    fi
}

rollback_restore() {
    local created_file=$1 name
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        tmux_cmd kill-session -t "=$name" 2>/dev/null || true
    done < "$created_file"
}

command_restore() {
    local client=${1:-} metadata active created_file status bootstrap=''
    [[ -f $RESTORE_FILE ]] || return 0
    if ! metadata=$(validate_snapshot); then
        debug_log 'restore rejected invalid snapshot'
        command_restore_discard "$client"
        die 'invalid restore snapshot'
    fi
    IFS=$'\t' read -r active _ <<< "$metadata"
    if [[ -n $client ]]; then
        bootstrap=$(tmux_cmd display-message -p -c "$client" '#{session_name}' 2>/dev/null || true)
    fi
    debug_log "restore started client=$client active=$active"
    created_file=$(mktemp "$STATE_ROOT/.restore-created.XXXXXX") || return 1
    tmux_cmd set-option -gq @atelier_restore_pending 1
    tmux_cmd set-option -gq @atelier_restore_handled 0
    set +e
    (
        set -e
        trap 'rollback_restore "$created_file"' EXIT
        restore_snapshot_data "$created_file"
        trap - EXIT
    )
    status=$?
    set -e
    rm -f "$created_file"
    if ((status != 0)); then
        tmux_cmd set-option -gq @atelier_restore_pending 1
        tmux_cmd set-option -gq @atelier_restore_handled 0
        debug_log 'restore failed; created sessions rolled back and retry enabled'
        die 'workspace restoration failed'
    fi
    tmux_cmd set-option -gq @atelier_restore_pending 0
    tmux_cmd set-option -gq @atelier_restore_handled 1
    command_snapshot
    command_refresh_status
    if [[ -n $client && -n $active ]] && session_exists "$active"; then
        tmux_cmd switch-client -c "$client" -t "=$active"
    fi
    if [[ -n $bootstrap && $bootstrap != "$active" ]] && session_exists "$bootstrap" &&
        [[ $(session_option "$bootstrap" @atelier_managed) != 1 ]]; then
        tmux_cmd kill-session -t "=$bootstrap"
        debug_log "restore removed bootstrap session=$bootstrap"
    fi
    debug_log "restore completed client=$client active=$active"
}

command_popup_restore() {
    local client=${1:-} metadata workspaces windows panes choice
    metadata=$(validate_snapshot) || die 'invalid restore snapshot'
    IFS=$'\t' read -r _ workspaces windows panes <<< "$metadata"
    trap 'command_restore_discard "$client" >/dev/null 2>&1 || true' EXIT
    printf 'Restore %s workspaces, %s tabs, and %s panes? [y/N] ' \
        "$workspaces" "$windows" "$panes"
    if read -r -n 1 choice && [[ $choice == y || $choice == Y ]]; then
        printf '\n'
        debug_log "restore prompt accepted client=$client workspaces=$workspaces tabs=$windows panes=$panes"
        trap - EXIT
        command_restore "$client"
    else
        printf '\nStarting fresh.\n'
        debug_log "restore prompt declined client=$client workspaces=$workspaces tabs=$windows panes=$panes"
        trap - EXIT
        command_restore_discard "$client"
    fi
}

command_restore_arm() {
    local handled session
    handled=$(tmux_cmd show-options -gqv @atelier_restore_handled 2>/dev/null || true)
    if [[ -n $handled ]]; then
        debug_log "restore arm skipped handled=$handled"
        return 0
    fi
    while IFS= read -r session; do
        if [[ -n $session && $(session_option "$session" @atelier_managed) == 1 ]]; then
            tmux_cmd set-option -gq @atelier_restore_handled 1
            tmux_cmd set-option -gq @atelier_restore_pending 0
            debug_log "restore arm found live managed session=$session"
            command_snapshot
            return 0
        fi
    done < <(session_names)
    if [[ -f $RESTORE_FILE ]]; then
        tmux_cmd set-option -gq @atelier_restore_handled 0
        tmux_cmd set-option -gq @atelier_restore_pending 1
        debug_log 'restore armed from saved snapshot'
    else
        tmux_cmd set-option -gq @atelier_restore_handled 1
        tmux_cmd set-option -gq @atelier_restore_pending 0
        debug_log 'restore arm found no saved snapshot'
    fi
}

command_restore_start() {
    local client=${1:-} mode handled cli qcli command
    handled=$(tmux_cmd show-options -gqv @atelier_restore_handled 2>/dev/null || true)
    if [[ $handled != 0 ]]; then
        debug_log "restore start skipped client=$client handled=$handled"
        return 0
    fi
    [[ -f $RESTORE_FILE ]] || { command_restore_discard "$client"; return; }
    mode=$(tmux_cmd show-options -gqv @atelier_restore 2>/dev/null || true)
    mode=${mode:-prompt}
    debug_log "restore start client=$client mode=$mode"
    [[ $mode == always || $mode == never || $mode == prompt ]] ||
        die 'invalid @atelier_restore value: expected always, never, or prompt'
    case $mode in
        always) command_restore "$client" ;;
        never) command_restore_discard "$client" ;;
        prompt)
            [[ -n $client ]] || return 0
            cli=$(cli_path); qcli=$(quote_sh "$cli")
            command="$qcli popup-restore $(quote_sh "$client")"
            tmux_cmd display-popup -c "$client" -E -w '55%' -h '20%' "$command"
            ;;
    esac
}

refresh_status_if_running() {
    tmux_cmd list-sessions >/dev/null 2>&1 || return 0
    command_refresh_status
}

select_session() {
    local name=$1 detached=${2:-0}
    ((detached)) && return 0
    if [[ -n ${TMUX:-} ]]; then
        tmux_cmd switch-client -t "=$name"
    else
        exec "$TMUX_BIN" attach-session -t "=$name"
    fi
}

command_new() {
    local target=${1:-} name=${2:-} detached=${3:-}
    [[ -n $target ]] || die 'usage: tmux-atelier new destination:path [name] [--detached]'
    [[ $name != --detached ]] || { detached=$name; name=; }
    [[ -z $detached || $detached == --detached ]] || die "unknown argument: $detached"

    parse_target "$target"
    [[ -n $name ]] || name=$(normalise_name "$WORKSPACE_PATH")
    validate_name "$name"
    [[ ! -e $(workspace_file "$name") ]] || die "workspace already exists: $name"
    ! session_exists "$name" || die "tmux session already exists: $name"
    [[ $WORKSPACE_DESTINATION != local || -d $WORKSPACE_PATH ]] ||
        die "local path is not a directory: $WORKSPACE_PATH"

    write_workspace "$name" "$WORKSPACE_DESTINATION" "$WORKSPACE_PATH" create ||
        die "workspace already exists: $name"
    if ! create_session "$name" "$WORKSPACE_DESTINATION" "$WORKSPACE_PATH"; then
        die "definition saved, but the session could not be created: $name"
    fi
    command_snapshot
    refresh_status_if_running
    select_session "$name" "$([[ $detached == --detached ]] && printf 1 || printf 0)"
}

command_open() {
    local name=${1:-} detached=${2:-} destination path
    [[ -n $name ]] || die 'usage: tmux-atelier open name [--detached]'
    validate_name "$name"
    [[ -z $detached || $detached == --detached ]] || die "unknown argument: $detached"

    if session_exists "$name" && [[ -f $(workspace_file "$name") ]]; then
        read_workspace "$name"
        destination=$(session_option "$name" @atelier_destination)
        path=$(session_option "$name" @atelier_path)
        [[ $(session_option "$name" @atelier_managed) == 1 &&
            $destination == "$WORKSPACE_DESTINATION" && $path == "$WORKSPACE_PATH" ]] ||
            die "saved workspace conflicts with tmux session: $name"
    elif ! session_exists "$name"; then
        read_workspace "$name"
        create_session "$name" "$WORKSPACE_DESTINATION" "$WORKSPACE_PATH"
    fi
    command_snapshot
    refresh_status_if_running
    select_session "$name" "$([[ $detached == --detached ]] && printf 1 || printf 0)"
}

current_session() {
    tmux_cmd display-message -p '#{session_name}'
}

command_window() {
    local session=${1:-} destination path command
    [[ -n $session ]] || session=$(current_session)
    if [[ $(session_option "$session" @atelier_managed) != 1 ]]; then
        tmux_cmd new-window -a -t "=$session:{end}"
        return
    fi
    destination=$(session_option "$session" @atelier_destination)
    path=$(session_option "$session" @atelier_path)
    if [[ $destination == local ]]; then
        tmux_cmd new-window -a -t "=$session:{end}" -c "$path"
    else
        command=$(remote_shell_command "$destination" "$path")
        tmux_cmd new-window -a -t "=$session:{end}" "$command"
    fi
    command_snapshot
}

command_split() {
    local orientation=${1:-} pane=${2:-} session destination path command
    [[ $orientation == vertical || $orientation == horizontal ]] ||
        die 'usage: tmux-atelier split vertical|horizontal [pane]'
    [[ -n $pane ]] || pane=$(tmux_cmd display-message -p '#{pane_id}')
    session=$(tmux_cmd display-message -p -t "$pane" '#{session_name}')

    local -a split_args=(split-window -t "$pane")
    [[ $orientation == vertical ]] && split_args+=(-h)
    if [[ $(session_option "$session" @atelier_managed) != 1 ]]; then
        tmux_cmd "${split_args[@]}"
        return
    fi
    destination=$(session_option "$session" @atelier_destination)
    path=$(session_option "$session" @atelier_path)
    if [[ $destination == local ]]; then
        tmux_cmd "${split_args[@]}" -c "$path"
    else
        command=$(remote_shell_command "$destination" "$path")
        tmux_cmd "${split_args[@]}" "$command"
    fi
    command_snapshot
}

definition_names() {
    local file
    [[ -d $WORKSPACES_DIR ]] || return 0
    while IFS= read -r -d '' file; do
        printf '%s\n' "${file##*/}"
    done < <(find "$WORKSPACES_DIR" -maxdepth 1 -type f ! -name '.*' -print0)
}

session_names() {
    tmux_cmd list-sessions -F '#{session_name}' 2>/dev/null || true
}

all_names() {
    local name created
    while IFS=$'\t' read -r created name; do
        [[ -n $name ]] && printf '%s\n' "$name"
    done < <({
        while IFS= read -r name; do
            [[ -n $name ]] || continue
            read_workspace "$name"
            created=$WORKSPACE_CREATED
            printf '%s\t%s\n' "$created" "$name"
        done < <(definition_names)
        while IFS=$'\t' read -r created name; do
            [[ -n $name && ! -f $WORKSPACES_DIR/$name ]] && printf '%s\t%s\n' "$created" "$name"
        done < <(tmux_cmd list-sessions -F $'#{session_created}\t#{session_name}' 2>/dev/null || true)
    } | LC_ALL=C sort -t $'\t' -k1,1n -k2,2)
}

escape_format() {
    printf '%s' "${1//#/##}"
}

clear_range_options() {
    local option value
    while read -r option value; do
        [[ $option == @atelier_range_* ]] || continue
        tmux_cmd set-option -gu "$option" 2>/dev/null || true
    done < <(tmux_cmd show-options -g 2>/dev/null || true)
}

workspace_label() {
    local name=$1 definition destination path
    if [[ -f $WORKSPACES_DIR/$name ]]; then
        if definition=$( (read_workspace "$name"; printf '%s\n%s' "$WORKSPACE_DESTINATION" "$WORKSPACE_PATH") 2>/dev/null); then
            destination=${definition%%$'\n'*}
            path=${definition#*$'\n'}
            if session_exists "$name" &&
                { [[ $(session_option "$name" @atelier_managed) != 1 ]] ||
                  [[ $(session_option "$name" @atelier_destination) != "$destination" ]] ||
                  [[ $(session_option "$name" @atelier_path) != "$path" ]]; }; then
                printf '%s@conflict' "$name"
                return
            fi
            destination=${destination##*@}
            printf '%s@%s' "$name" "$destination"
        else
            printf '%s@invalid' "$name"
        fi
    elif [[ $(session_option "$name" @atelier_managed) == 1 ]]; then
        destination=$(session_option "$name" @atelier_destination)
        printf '%s@%s' "$name" "${destination##*@}"
    else
        printf '%s@tmux' "$name"
    fi
}

status_line_for() {
    local active=$1 name token label style line='' index=0
    local active_style live_style stopped_style add_style separator
    active_style=$(tmux_cmd show-options -gqv @atelier_workspace_active_style)
    live_style=$(tmux_cmd show-options -gqv @atelier_workspace_live_style)
    stopped_style=$(tmux_cmd show-options -gqv @atelier_workspace_stopped_style)
    add_style=$(tmux_cmd show-options -gqv @atelier_add_style)
    separator=$(escape_format "$(tmux_cmd show-options -gqv @atelier_separator)")
    active_style=${active_style:-reverse}
    live_style=${live_style:-bold}
    stopped_style=${stopped_style:-dim}
    add_style=${add_style:-bold}
    separator=${separator:-│}
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        token="a$index"
        tmux_cmd set-option -gq "@atelier_range_$token" "$name"
        label=$(escape_format "$(workspace_label "$name")")
        if [[ $name == "$active" ]]; then
            style=$active_style
        elif session_exists "$name"; then
            style=$live_style
        else
            style=$stopped_style
        fi
        line+="#[range=user|$token,$style] $label #[default,norange]$separator"
        ((++index))
    done < <(all_names)
    line+="#[range=user|new,$add_style] + #[default,norange]"
    printf '%s\n' "$line"
}

command_refresh_status() {
    local session line status_format
    status_format=$(tmux_cmd show-options -gqv @atelier_tabs_format 2>/dev/null || true)
    clear_range_options
    while IFS= read -r session; do
        [[ -n $session ]] || continue
        line=$(status_line_for "$session")
        tmux_cmd set-option -q -t "=$session:" 'status-format[0]' "$status_format"
        tmux_cmd set-option -q -t "=$session:" 'status-format[1]' "$line"
    done < <(session_names)
}

range_name() {
    local token=$1
    tmux_cmd show-options -gqv "@atelier_range_$token" 2>/dev/null || true
}

command_status_click() {
    local token=${1:-} client=${2:-} session=${3:-} name
    [[ $token == new ]] && { command_show_new_popup "$client"; return; }
    if [[ $token == new-tab ]]; then
        if [[ -z $session && -n $client ]]; then
            session=$(tmux_cmd display-message -p -c "$client" '#{session_name}')
        fi
        command_window "$session"
        return
    fi
    name=$(range_name "$token")
    [[ -n $name ]] || return 0
    if session_exists "$name"; then
        if [[ -n $client ]]; then
            tmux_cmd switch-client -c "$client" -t "=$name"
        else
            tmux_cmd switch-client -t "=$name"
        fi
    else
        command_open "$name"
    fi
}

command_show_new_popup() {
    local client=${1:-} cli qcli
    cli=$(cli_path)
    qcli=$(quote_sh "$cli")
    if [[ -n $client ]]; then
        tmux_cmd display-popup -c "$client" -e "TMUX_ATELIER_CLIENT=$client" \
            -E -w '70%' -h '60%' "$qcli popup-new"
    else
        tmux_cmd display-popup -E -w '70%' -h '60%' "$qcli popup-new"
    fi
}

command_status_menu() {
    local token=${1:-} client=${2:-} name
    name=$(range_name "$token")
    debug_log "status-menu token=$token resolved=$name requested_client=$client"
    [[ -n $name ]] || return 0
    command_menu "$name" "$client"
}

cli_path() {
    local configured
    configured=$(tmux_cmd show-options -gqv @atelier_cli 2>/dev/null || true)
    [[ -n $configured ]] || die '@atelier_cli is not configured'
    printf '%s\n' "$configured"
}

command_menu() {
    local name=${1:-} client=${2:-} cli qcli qname command
    [[ -n $name ]] || die 'usage: tmux-atelier menu name'
    validate_name "$name"
    cli=$(cli_path)
    qcli=$(quote_sh "$cli")
    qname=$(quote_sh "$name")
    command="$qcli popup-workspace-menu $qname"
    local -a popup_args=(display-popup)
    [[ -n $client ]] && popup_args+=(-c "$client" -e "TMUX_ATELIER_CLIENT=$client")
    debug_log "workspace-menu opening name=$name target_client=$client"
    tmux_cmd "${popup_args[@]}" -E -w '45%' -h '35%' "$command"
    debug_log "workspace-menu closed name=$name target_client=$client status=0"
}

choose_action() {
    local prompt=$1
    fzf --prompt="$prompt > " --height=100% --border --no-info
}

command_popup_workspace_menu() {
    local name=${1:-} file action client=${TMUX_ATELIER_CLIENT:-}
    validate_name "$name"
    file=$(workspace_file "$name")
    debug_log "workspace-fzf started name=$name inherited_client=$client"
    if ! action=$({
        printf 'Open workspace\nRename workspace\n'
        [[ -f $file ]] && ! session_exists "$name" && printf 'Edit target\n'
        session_exists "$name" && printf 'Close workspace\n'
        [[ -f $file ]] && printf 'Delete saved workspace\n'
        true
    } | choose_action "$name"); then
        debug_log "workspace-fzf cancelled name=$name inherited_client=$client"
        return 0
    fi
    debug_log "workspace-fzf selected name=$name action=$action inherited_client=$client"

    case $action in
        'Open workspace') command_open "$name" ;;
        'Rename workspace') command_defer_request request-rename "$name" "$client" ;;
        'Edit target') command_popup_edit "$name" ;;
        'Close workspace') command_defer_request request-close "$name" "$client" ;;
        'Delete saved workspace') command_defer_request request-delete "$name" "$client" ;;
    esac
}

command_popup_tab_menu() {
    local window=${1:-} name action client=${TMUX_ATELIER_CLIENT:-}
    [[ $window =~ ^@[0-9]+$ ]] || die "invalid tmux window id: $window"
    name=$(tmux_cmd display-message -p -t "$window" '#{window_name}')
    debug_log "tab-fzf started window=$window name=$name inherited_client=$client"
    if ! action=$(printf 'Rename tab\nClose tab\n' | choose_action "$name"); then
        debug_log "tab-fzf cancelled window=$window inherited_client=$client"
        return 0
    fi
    debug_log "tab-fzf selected window=$window action=$action inherited_client=$client"

    case $action in
        'Rename tab')
            command_defer_request request-tab-rename "$window" "$client"
            ;;
        'Close tab')
            command_defer_request request-tab-close "$window" "$client"
            ;;
    esac
}

command_defer_request() {
    local request=$1 target=$2 client=${3:-} cli qcli qlog command
    cli=$(cli_path); qcli=$(quote_sh "$cli")
    qlog=$(quote_sh "$DEBUG_LOG")
    command="$qcli $request $(quote_sh "$target")"
    [[ -z $client ]] || command+=" $(quote_sh "$client")"
    command+=" >>$qlog 2>&1"
    debug_log "defer scheduling request=$request target=$target target_client=$client"
    tmux_cmd run-shell -b -d 0.1 "$command"
    debug_log "defer scheduled request=$request target=$target target_client=$client status=0"
}

command_request_tab_rename() {
    local window=${1:-} client=${2:-} cli qcli command
    [[ $window =~ ^@[0-9]+$ ]] || die "invalid tmux window id: $window"
    cli=$(cli_path); qcli=$(quote_sh "$cli")
    command="$qcli popup-tab-rename $(quote_sh "$window")"
    local -a popup_args=(display-popup)
    [[ -z $client ]] || popup_args+=(-c "$client")
    debug_log "tab-rename-popup opening window=$window target_client=$client"
    tmux_cmd "${popup_args[@]}" -E -w '50%' -h '20%' "$command"
    debug_log "tab-rename-popup closed window=$window target_client=$client status=0"
}

command_popup_tab_rename() {
    local window=${1:-} name new
    [[ $window =~ ^@[0-9]+$ ]] || die "invalid tmux window id: $window"
    name=$(tmux_cmd display-message -p -t "$window" '#{window_name}')
    debug_log "tab-rename-input started window=$window current_name=$name"
    if ! read -r -e -p 'New tab name: ' -i "$name" new; then
        debug_log "tab-rename-input cancelled window=$window"
        return 0
    fi
    debug_log "tab-rename-input submitted window=$window length=${#new}"
    validate_value 'tab name' "$new"
    tmux_cmd rename-window -t "$window" "$new"
    command_snapshot
    debug_log "tab-rename-input completed window=$window"
}

command_request_tab_close() {
    local window=${1:-} client=${2:-} name cli qcli command
    [[ $window =~ ^@[0-9]+$ ]] || die "invalid tmux window id: $window"
    name=$(tmux_cmd display-message -p -t "$window" '#{window_name}')
    cli=$(cli_path); qcli=$(quote_sh "$cli")
    command="run-shell -b \"$qcli tab-close $(quote_sh "$window")\""
    local -a confirm_args=(confirm-before)
    [[ -z $client ]] || confirm_args+=(-t "$client")
    tmux_cmd "${confirm_args[@]}" -p "Close tab $name? (y/n)" "$command"
}

command_tab_close() {
    local window=${1:-} session window_count
    [[ $window =~ ^@[0-9]+$ ]] || die "invalid tmux window id: $window"
    session=$(tmux_cmd display-message -p -t "$window" '#{session_name}')
    window_count=$(tmux_cmd display-message -p -t "$window" '#{session_windows}')
    if ((window_count == 1)); then
        command_snapshot "$session"
    else
        command_snapshot '' "$window"
    fi
    if ! tmux_cmd kill-window -t "$window"; then
        command_snapshot
        return 1
    fi
    refresh_status_if_running
}

command_close() {
    local name=${1:-}
    validate_name "$name"
    session_exists "$name" || die "session is not running: $name"
    command_snapshot "$name"
    if ! tmux_cmd kill-session -t "=$name"; then
        command_snapshot
        return 1
    fi
    refresh_status_if_running
}

command_delete() {
    local name=${1:-} file
    file=$(workspace_file "$name")
    [[ -f $file ]] || die "workspace definition not found: $name"
    rm -f "$file"
    command_snapshot
    refresh_status_if_running
}

command_request_close() {
    local name=${1:-} client=${2:-} cli qcli qname command
    validate_name "$name"
    cli=$(cli_path); qcli=$(quote_sh "$cli"); qname=$(quote_sh "$name")
    command="run-shell -b \"$qcli close $qname\""
    local -a confirm_args=(confirm-before)
    [[ -z $client ]] || confirm_args+=(-t "$client")
    tmux_cmd "${confirm_args[@]}" -p "Close session $name? (y/n)" "$command"
}

command_request_rename() {
    local name=${1:-} client=${2:-} cli qcli qname command
    validate_name "$name"
    cli=$(cli_path); qcli=$(quote_sh "$cli"); qname=$(quote_sh "$name")
    command="$qcli popup-rename $qname"
    local -a popup_args=(display-popup)
    [[ -z $client ]] || popup_args+=(-c "$client")
    debug_log "workspace-rename-popup opening name=$name target_client=$client"
    tmux_cmd "${popup_args[@]}" -E -w '50%' -h '20%' "$command"
    debug_log "workspace-rename-popup closed name=$name target_client=$client status=0"
}

command_request_delete() {
    local name=${1:-} client=${2:-} cli qcli qname command
    validate_name "$name"
    cli=$(cli_path); qcli=$(quote_sh "$cli"); qname=$(quote_sh "$name")
    command="run-shell -b \"$qcli delete $qname\""
    local -a confirm_args=(confirm-before)
    [[ -z $client ]] || confirm_args+=(-t "$client")
    tmux_cmd "${confirm_args[@]}" -p "Delete definition $name? (y/n)" "$command"
}

command_rename() {
    local old=${1:-} new=${2:-} old_file new_file session_renamed=0
    local destination='' path='' created=''
    validate_name "$old"
    validate_name "$new"
    [[ $old != "$new" ]] || return 0
    old_file=$(workspace_file "$old")
    new_file=$(workspace_file "$new")
    [[ ! -e $new_file ]] || die "workspace already exists: $new"
    ! session_exists "$new" || die "tmux session already exists: $new"
    [[ -f $old_file ]] || session_exists "$old" || die "workspace not found: $old"

    if [[ -f $old_file ]]; then
        read_workspace "$old"
        destination=$WORKSPACE_DESTINATION
        path=$WORKSPACE_PATH
        created=$WORKSPACE_CREATED
    fi

    if session_exists "$old"; then
        tmux_cmd rename-session -t "=$old" "$new"
        session_renamed=1
    fi
    if [[ -f $old_file ]]; then
        if ! write_workspace "$new" "$destination" "$path" create "$created"; then
            ((session_renamed)) && tmux_cmd rename-session -t "=$new" "$old" || true
            die "could not rename workspace: $old"
        fi
        rm -f "$old_file"
    fi
    command_snapshot
    refresh_status_if_running
}

command_edit() {
    local name=${1:-} target=${2:-}
    validate_name "$name"
    [[ -n $target ]] || die 'usage: tmux-atelier edit name destination:path'
    ! session_exists "$name" || die "close the session before editing its target: $name"
    read_workspace "$name"
    parse_target "$target"
    [[ $WORKSPACE_DESTINATION != local || -d $WORKSPACE_PATH ]] ||
        die "local path is not a directory: $WORKSPACE_PATH"
    write_workspace "$name" "$WORKSPACE_DESTINATION" "$WORKSPACE_PATH" replace "$WORKSPACE_CREATED" ||
        die "could not update workspace: $name"
    refresh_status_if_running
}

ssh_aliases_from() {
    local file=$1 line keyword rest pattern include base expanded
    local -a lines patterns includes
    [[ -f $file ]] || return 0
    file=$(readlink -f "$file")
    [[ -z ${SSH_CONFIG_SEEN[$file]:-} ]] || return 0
    SSH_CONFIG_SEEN[$file]=1
    mapfile -t lines < "$file"
    for line in "${lines[@]}"; do
        line=${line%%#*}
        read -r keyword rest <<< "$line"
        case ${keyword,,} in
            host)
                read -r -a patterns <<< "$rest"
                for pattern in "${patterns[@]}"; do
                    [[ $pattern != *['*?!']* && $pattern != '!'* ]] && printf '%s\n' "$pattern"
                done
                ;;
            include)
                base=${file%/*}
                read -r -a includes <<< "$rest"
                for include in "${includes[@]}"; do
                    include=${include/#\~/$HOME}
                    [[ $include == /* ]] || include="$base/$include"
                    while IFS= read -r expanded; do
                        [[ -n $expanded && $expanded != "$file" ]] && ssh_aliases_from "$expanded"
                    done < <(compgen -G "$include" || true)
                done
                ;;
        esac
    done
}

ssh_alias_choice() {
    local alias=$1 config key value user='' hostname='' port=''
    config=$(ssh -G -- "$alias" 2>/dev/null) || return 0
    while read -r key value; do
        case $key in
            user) [[ -n $user ]] || user=$value ;;
            hostname) [[ -n $hostname ]] || hostname=$value ;;
            port) [[ -n $port ]] || port=$value ;;
        esac
    done <<< "$config"
    [[ -n $user && -n $hostname ]] || return 0
    debug_log "new-workspace ssh-alias alias=$alias resolved=$user@$hostname:${port:-22}"
    printf 'alias\t%s  %s@%s:%s\t%s\n' "$alias" "$user" "$hostname" "${port:-22}" "$alias"
}

choose_machine() {
    local choice alias choices
    SSH_CONFIG_SEEN=()
    choices=$({
        printf 'local\tLocal\tlocal\ncustom\tCustom SSH destination\t\n'
        while IFS= read -r alias; do
            [[ -n $alias ]] && ssh_alias_choice "$alias"
        done < <(ssh_aliases_from "$HOME/.ssh/config" | LC_ALL=C sort -u)
        true
    })
    debug_log "new-workspace machine-fzf started rows=$(printf '%q' "$choices")"
    if ! choice=$(FZF_DEFAULT_COMMAND=false fzf --delimiter=$'\t' --with-nth=2 \
        --prompt='Machine > ' --height=100% --border --no-info <<< "$choices"); then
        debug_log 'new-workspace machine-fzf cancelled'
        return 1
    fi
    debug_log "new-workspace machine-fzf selected=$(printf '%q' "$choice")"
    printf '%s\n' "$choice"
}

canonical_local_path() {
    local path=$1
    [[ -d $path ]] || return 1
    (cd -- "$path" && pwd -P)
}

create_local_path() {
    local path=$1
    mkdir -p -- "$path"
    canonical_local_path "$path"
}

create_remote_path() {
    local destination=$1 path=$2 inner remote
    # $1 is expanded by the remote shell.
    # shellcheck disable=SC2016
    inner='mkdir -p -- "$1" && cd -- "$1" && pwd -P'
    remote="sh -c $(quote_sh "$inner") sh $(quote_sh "$path")"
    ssh_cmd "$destination" "$remote"
}

remote_home() {
    local destination=$1
    # $HOME is expanded by the remote shell.
    # shellcheck disable=SC2016
    ssh_cmd "$destination" 'printf "%s\n" "$HOME"'
}

local_directories() {
    (
        local path=$1 entry name
        local -a entries
        shopt -s nullglob dotglob
        entries=("$path"/*)
        {
            for entry in "${entries[@]}"; do
                name=${entry##*/}
                [[ -d $entry && $name != *$'\n'* ]] && printf '%s\n' "$name"
            done
            true
        } | LC_ALL=C sort
    )
}

remote_directories() {
    local destination=$1 path=$2 inner remote
    # Variables in this script are expanded by the remote shell.
    # shellcheck disable=SC2016
    inner='cd -- "$1" 2>/dev/null || exit 1
for entry in ./* ./.[!.]* ./..?*; do
    [ -d "$entry" ] || continue
    name=${entry#./}
    case $name in *"
"*) continue ;; esac
    printf "%s\n" "$name"
done'
    remote="sh -c $(quote_sh "$inner") sh $(quote_sh "$path")"
    ssh_cmd "$destination" "$remote" | LC_ALL=C sort -u
}

resolve_custom_path() {
    local home=$1 input=$2 tilde='~'
    case $input in
        "$tilde") printf '%s\n' "$home" ;;
        "$tilde/"*) printf '%s/%s\n' "${home%/}" "${input#\~/}" ;;
        /*) printf '%s\n' "$input" ;;
        *) printf '%s/%s\n' "${home%/}" "$input" ;;
    esac
}

parent_path() {
    local path=${1%/}
    [[ $path != / ]] || { printf '/\n'; return; }
    path=${path%/*}
    printf '%s\n' "${path:-/}"
}

display_path() {
    local home=$1 path=$2 tilde='~'
    if [[ $path == "$home" ]]; then
        printf '%s/\n' "$tilde"
    elif [[ $path == "$home"/* ]]; then
        printf '%s/%s\n' "$tilde" "${path#"$home"/}"
    else
        printf '%s\n' "$path"
    fi
}

choose_directory() {
    local destination=$1 home=$2 current=$2 result query choice choice_type candidate name prompt directories choices
    while true; do
        if [[ $destination == local ]]; then
            directories=$(local_directories "$current") || return 1
        else
            directories=$(remote_directories "$destination" "$current") || {
                printf 'Could not list remote directory: %s\n' "$current" >&2
                return 1
            }
        fi
        prompt="$(display_path "$home" "$current") > "
        choices=$({
            printf 'select\t< Select this folder>\nback\t< Back>\n'
            [[ $current == / ]] || printf 'up\t< Up>\n'
            if [[ -n $directories ]]; then
                while IFS= read -r name; do
                    printf 'directory\t%s\n' "$name"
                done <<< "$directories"
            fi
            true
        })
        debug_log "new-workspace directory-fzf started destination=$destination current=$(printf '%q' "$current") rows=$(printf '%q' "$choices")"
        if ! result=$(FZF_DEFAULT_COMMAND=false fzf --delimiter=$'\t' --with-nth=2.. \
            --prompt="$prompt" --height=100% --border --no-info --print-query \
            --bind='enter:accept-or-print-query' <<< "$choices"); then
            debug_log "new-workspace directory-fzf cancelled destination=$destination current=$(printf '%q' "$current")"
            return 1
        fi
        query=${result%%$'\n'*}
        if [[ $result == *$'\n'* ]]; then
            choice=${result#*$'\n'}
        else
            choice=
        fi
        debug_log "new-workspace directory-fzf selected destination=$destination current=$(printf '%q' "$current") query=$(printf '%q' "$query") choice=$(printf '%q' "$choice")"

        if [[ $choice != *$'\t'* ]]; then
            [[ -n $query ]] || continue
            candidate=$(resolve_custom_path "$home" "$query")
            if [[ $destination == local ]]; then
                create_local_path "$candidate"
            else
                create_remote_path "$destination" "$candidate"
            fi
            return
        fi

        choice_type=${choice%%$'\t'*}
        case $choice_type in
            select) printf '%s\n' "$current"; return 0 ;;
            back) return 2 ;;
            up) current=$(parent_path "$current") ;;
            directory)
                name=${choice#*$'\t'}
                [[ $current == / ]] && current="/$name" || current="$current/$name"
                ;;
        esac
    done
}

command_popup_new() {
    local machine machine_type destination home path suggested name status target
    local client=${TMUX_ATELIER_CLIENT:-}
    while true; do
        machine=$(choose_machine) || return 0
        machine_type=${machine%%$'\t'*}
        destination=${machine##*$'\t'}
        debug_log "new-workspace machine-type=$machine_type destination=$destination"
        case $machine_type in
            local)
                destination=local
                home=$HOME
                ;;
            custom)
                read -r -e -p 'OpenSSH destination (user@host or alias): ' destination || continue
                validate_destination "$destination"
                home=$(remote_home "$destination") || {
                    printf 'Could not connect to %s.\n' "$destination" >&2
                    continue
                }
                ;;
            alias)
                validate_destination "$destination"
                home=$(remote_home "$destination") || {
                    printf 'Could not connect to %s.\n' "$destination" >&2
                    continue
                }
                ;;
            *) continue ;;
        esac
        if path=$(choose_directory "$destination" "$home"); then
            status=0
        else
            status=$?
        fi
        ((status == 0)) || {
            debug_log "new-workspace directory status=$status destination=$destination"
            ((status == 2)) && continue
            return 0
        }
        suggested=$(normalise_name "$path")
        read -r -e -p 'Workspace name: ' -i "$suggested" name || continue
        debug_log "new-workspace name-submitted length=${#name} destination=$destination path=$(printf '%q' "$path")"
        target="$destination:$path"
        command_new "$target" "$name" --detached
        if [[ -n $client ]]; then
            tmux_cmd switch-client -c "$client" -t "=$name"
        else
            select_session "$name"
        fi
        return
    done
}

command_popup_rename() {
    local old=${1:-} new
    validate_name "$old"
    debug_log "workspace-rename-input started name=$old"
    if ! read -r -e -p 'New workspace name: ' -i "$old" new; then
        debug_log "workspace-rename-input cancelled name=$old"
        return 0
    fi
    debug_log "workspace-rename-input submitted name=$old length=${#new}"
    command_rename "$old" "$new"
    debug_log "workspace-rename-input completed old=$old new=$new"
}

command_popup_edit() {
    local name=${1:-} target
    validate_name "$name"
    ! session_exists "$name" || die "close the session before editing its target: $name"
    read_workspace "$name"
    read -r -e -p 'Target: ' -i "$WORKSPACE_DESTINATION:$WORKSPACE_PATH" target || return 0
    command_edit "$name" "$target"
}

usage() {
    cat <<'EOF'
Usage: tmux-atelier COMMAND [ARGUMENTS]

Commands:
  new TARGET [NAME] [--detached]
  open NAME [--detached]
  window [SESSION]
  split vertical|horizontal [PANE]
  rename OLD NEW
  edit NAME TARGET
  close NAME
  delete NAME
  popup-new
  popup-workspace-menu NAME
  popup-tab-menu WINDOW_ID
  snapshot
  restore-start [CLIENT]
  adopt-session SESSION [CLIENT]
  refresh-status
EOF
}

main() {
    local command=${1:-}
    [[ -n $command ]] || { usage; exit 1; }
    shift
    case $command in
        new) ((1 <= $# && $# <= 3)) || die 'usage: tmux-atelier new destination:path [name] [--detached]'; command_new "$@" ;;
        open) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier open name [--detached]'; command_open "$@" ;;
        window) (($# <= 1)) || die 'usage: tmux-atelier window [session]'; command_window "$@" ;;
        split) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier split vertical|horizontal [pane]'; command_split "$@" ;;
        rename) (($# == 2)) || die 'usage: tmux-atelier rename old new'; command_rename "$@" ;;
        edit) (($# == 2)) || die 'usage: tmux-atelier edit name destination:path'; command_edit "$@" ;;
        close) (($# == 1)) || die 'usage: tmux-atelier close name'; command_close "$@" ;;
        delete) (($# == 1)) || die 'usage: tmux-atelier delete name'; command_delete "$@" ;;
        popup-new) (($# == 0)) || die 'usage: tmux-atelier popup-new'; command_popup_new ;;
        popup-workspace-menu) (($# == 1)) || die 'usage: tmux-atelier popup-workspace-menu name'; command_popup_workspace_menu "$@" ;;
        popup-tab-menu) (($# == 1)) || die 'usage: tmux-atelier popup-tab-menu window-id'; command_popup_tab_menu "$@" ;;
        popup-restore) (($# <= 1)) || die 'usage: tmux-atelier popup-restore [client]'; command_popup_restore "$@" ;;
        popup-tab-rename) (($# == 1)) || die 'usage: tmux-atelier popup-tab-rename window-id'; command_popup_tab_rename "$@" ;;
        popup-rename) (($# == 1)) || die 'usage: tmux-atelier popup-rename name'; command_popup_rename "$@" ;;
        popup-edit) (($# == 1)) || die 'usage: tmux-atelier popup-edit name'; command_popup_edit "$@" ;;
        refresh-status) (($# == 0)) || die 'usage: tmux-atelier refresh-status'; command_refresh_status ;;
        status-click) ((1 <= $# && $# <= 3)) || die 'usage: tmux-atelier status-click range [client] [session]'; command_status_click "$@" ;;
        status-menu) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier status-menu range [client]'; command_status_menu "$@" ;;
        menu) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier menu name [client]'; command_menu "$@" ;;
        request-close) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier request-close name [client]'; command_request_close "$@" ;;
        request-rename) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier request-rename name [client]'; command_request_rename "$@" ;;
        request-tab-rename) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier request-tab-rename window-id [client]'; command_request_tab_rename "$@" ;;
        request-tab-close) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier request-tab-close window-id [client]'; command_request_tab_close "$@" ;;
        tab-close) (($# == 1)) || die 'usage: tmux-atelier tab-close window-id'; command_tab_close "$@" ;;
        request-delete) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier request-delete name [client]'; command_request_delete "$@" ;;
        snapshot) (($# == 0)) || die 'usage: tmux-atelier snapshot'; command_snapshot ;;
        restore-arm) (($# == 0)) || die 'usage: tmux-atelier restore-arm'; command_restore_arm ;;
        restore-start) (($# <= 1)) || die 'usage: tmux-atelier restore-start [client]'; command_restore_start "$@" ;;
        restore) (($# <= 1)) || die 'usage: tmux-atelier restore [client]'; command_restore "$@" ;;
        restore-discard) (($# == 0)) || die 'usage: tmux-atelier restore-discard'; command_restore_discard ;;
        adopt-session) ((1 <= $# && $# <= 2)) || die 'usage: tmux-atelier adopt-session session [client]'; command_adopt_session "$@" ;;
        debug-path) (($# == 0)) || die 'usage: tmux-atelier debug-path'; printf '%s\n' "$DEBUG_LOG" ;;
        debug-clear) (($# == 0)) || die 'usage: tmux-atelier debug-clear'; mkdir -p "$STATE_ROOT"; : > "$DEBUG_LOG"; chmod 600 "$DEBUG_LOG" ;;
        help|-h|--help) (($# == 0)) || die 'usage: tmux-atelier help'; usage ;;
        *) die "unknown command: $command" ;;
    esac
}

main "$@"
